@*
    B29: tài khoản đang dùng mật khẩu tạm mở một trang nghiệp vụ → /change-password?returnUrl=<trang đó> (thay mục lịch sử,
    Back không quay lại trang bị chặn). Chỉ chuyển một lần; trong lúc chờ chỉ có vòng quay.
*@
@inject NavigationManager Nav
@inject AuthNavigator Navigator

<div class="auth-wait" role="status">
    <span class="auth-wait-spinner" aria-hidden="true"></span>
    <span>Đang mở trang đổi mật khẩu…</span>
</div>

@code {
    protected override void OnInitialized()
    {
        if (Navigator.IsLeaving) return;   // đang đăng xuất / về trang đăng nhập
        Nav.NavigateTo(AuthText.ChangePasswordUrl("/" + Nav.ToBaseRelativePath(Nav.Uri)), replace: true);
    }
}

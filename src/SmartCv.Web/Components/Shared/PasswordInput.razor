@*
    B29: ô mật khẩu có nhãn, nút Hiện / Ẩn, lỗi ngay dưới ô (aria-invalid + aria-describedby). Giá trị KHÔNG bị trim.
    Dùng cho trang Đổi mật khẩu và hộp thoại Tạo tài khoản.
*@
<div class="pw-field">
    <label class="pw-label" for="@Id">@Label</label>
    <div class="pw-wrap">
        <input id="@Id" @ref="input" class="sc-input pw-input" type="@(Show ? "text" : "password")" name="@Id"
               autocomplete="@Autocomplete" autocapitalize="none" spellcheck="false" maxlength="@MaxLength" readonly="@ReadOnly"
               value="@Value" @oninput="OnInput"
               aria-invalid="@(Error is null ? "false" : "true")" aria-describedby="@DescribedBy" />
        <button type="button" class="pw-toggle" @onclick="ToggleAsync" aria-controls="@Id"
                aria-pressed="@(Show ? "true" : "false")" aria-label="@((Show ? "Ẩn " : "Hiện ") + Label.ToLowerInvariant())" title="@(Show ? "Ẩn" : "Hiện")">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@(Show ? EyeOffIcon : EyeIcon)" /></svg>
        </button>
    </div>
    @if (Hint is not null)
    {
        <p class="pw-hint" id="@($"{Id}-hint")">@Hint</p>
    }
    @if (Error is not null)
    {
        <p class="pw-error" id="@($"{Id}-error")">@Error</p>
    }
    @ChildContent
</div>

@code {
    private const string EyeIcon = "M12 5c5 0 9 4.5 10 7-1 2.5-5 7-10 7S3 14.5 2 12c1-2.5 5-7 10-7zm0 3a4 4 0 1 0 0 8a4 4 0 0 0 0-8zm0 2a2 2 0 1 1 0 4a2 2 0 0 1 0-4z";
    private const string EyeOffIcon = "M3.3 2 2 3.3l3.2 3.2C3.6 7.8 2.5 9.9 2 12c1 2.5 5 7 10 7 1.9 0 3.6-.6 5.1-1.5L20.7 21l1.3-1.3zM12 5c5 0 9 4.5 10 7-.4 1-1.2 2.3-2.3 3.5L16 11.8V12a4 4 0 0 0-4-4h-.2L9.4 5.6C10.2 5.2 11.1 5 12 5zm-3.9 5.4 5.5 5.5A4 4 0 0 1 8.1 10.4z";

    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback<bool> ShowChanged { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "current-password";
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? ExtraDescribedBy { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public int MaxLength { get; set; } = SmartCv.Core.Auth.PasswordRules.MaxLength;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference input;

    private string? DescribedBy
    {
        get
        {
            var ids = new List<string>();
            if (Hint is not null) ids.Add($"{Id}-hint");
            if (Error is not null) ids.Add($"{Id}-error");
            if (ExtraDescribedBy is not null) ids.Add(ExtraDescribedBy);
            return ids.Count == 0 ? null : string.Join(' ', ids);
        }
    }

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
    private Task ToggleAsync() => ShowChanged.InvokeAsync(!Show);

    public async Task FocusAsync()
    {
        try { await input.FocusAsync(); }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException) { }
    }
}

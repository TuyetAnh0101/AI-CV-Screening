@*
    B24: khung hộp thoại dùng chung cho Sửa / Tạo ứng viên, Gộp, Xóa dữ liệu.
    <dialog> gốc + showModal: bẫy focus và Escape do trình duyệt xử lý; đóng thì trả focus về nút đã mở hộp thoại.
    Đang lưu (Busy) thì không đóng được bằng Escape hay nút ×.
*@
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog class="modal-shell @(Wide ? "wide" : null) @(Danger ? "danger" : null)" @ref="dialog" aria-labelledby="@($"{Id}-title")" aria-describedby="@(Description is null ? null : $"{Id}-description")" aria-busy="@(Busy ? "true" : "false")">
    <header class="modal-head">
        <div>@if (Eyebrow is not null) { <p class="modal-eyebrow">@Eyebrow</p> }<h2 id="@($"{Id}-title")">@Title</h2></div>
        <button id="@($"{Id}-close")" type="button" class="modal-close" aria-label="Đóng hộp thoại" disabled="@Busy" @onclick="CloseAsync">×</button>
    </header>
    @if (Description is not null) { <p id="@($"{Id}-description")" class="modal-description">@Description</p> }
    <div class="modal-body">@ChildContent</div>
    @if (Footer is not null) { <footer class="modal-foot">@Footer</footer> }
</dialog>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Wide { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public string? FocusId { get; set; }
    [Parameter] public string? ReturnFocusId { get; set; }
    [Parameter] public string? FallbackFocusId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference dialog;
    private IJSObjectReference? module;
    private DotNetObjectReference<ModalShell>? reference;
    private bool disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;
        try
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./js/modal-dialog.js");
            if (disposed) { await imported.DisposeAsync(); return; }
            module = imported; reference = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("open", dialog, reference, FocusId);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or JSException) { }
    }

    [JSInvokable] public Task CancelFromBrowser() => InvokeAsync(CloseAsync);
    private Task CloseAsync() => Busy ? Task.CompletedTask : OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("close", dialog, ReturnFocusId, FallbackFocusId); await module.DisposeAsync(); }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or JSException) { }
        }
        reference?.Dispose();
    }
}


@page "/"
@attribute [AllowAnonymous]
@layout PublicLayout

@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
@inject PublicSettingsClient PublicSettings
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>
    SCApp — Sàng lọc CV bằng AI cho người tuyển dụng
</PageTitle>

<HeadContent>
    <meta name="description"
          content="SCApp hỗ trợ đội ngũ tuyển dụng quản lý vị trí, phân tích CV bằng từ khóa và AI, xem kết quả xếp hạng có giải thích và đưa ra quyết định tuyển dụng." />
</HeadContent>

@if (!ready || redirecting)
{
    <div class="lp-loading" role="status">
        Đang chuẩn bị trang giới thiệu…
    </div>
}
else
{
    <div class="lp-page" @ref="pageRoot">

        @* 1. Banner giới thiệu, minh họa sản phẩm và CTA *@
        <LandingHero Cta="cta" />

        @* 2. Tính năng (Bento Grid) *@
        <FeatureGrid />

        @* 3. Xem trước trải nghiệm sản phẩm theo tab *@
        <LandingProductShowcase />

        @* 4. Quy trình sử dụng *@
        <HowItWorks />

        @* 5. Vai trò của AI *@
        <LandingAiSection />

        @* 6. Đối tượng sử dụng *@
        <LandingAudienceSection />

        @* 7. Lợi ích dành cho người tuyển dụng *@
        <BenefitList />

        @* 8. Bảo vệ dữ liệu ứng viên *@
        <DataProtectionSection />

        @* 9. Câu hỏi thường gặp *@
        <FaqSection />

        @* 10. Kêu gọi hành động cuối trang *@
        <CtaBand Cta="cta" />

        <a class="lp-to-top" href="/#main-content" data-lp-top aria-label="Quay lại đầu trang">
            <LandingIcon Name="arrow-up" Size="18" />
        </a>

    </div>
}

@code {
    private bool ready;
    private bool redirecting;

    // JavaScript chỉ phục vụ hiệu ứng giao diện; nội dung vẫn đọc được nếu module không tải được.
    private ElementReference pageRoot;
    private IJSObjectReference? module;
    private IJSObjectReference? effects;
    private bool effectsRequested;
    private bool disposed;

    // CTA mặc định an toàn khi chưa có cấu hình.
    private PublicCta cta = PublicCta.SignIn;

    protected override async Task OnInitializedAsync()
    {
        // 1. Khôi phục trạng thái xác thực.
        var state =
            await AuthProvider.GetAuthenticationStateAsync();

        var canUseApp =
            AccessRules.CanUseApp(state.User);

        var mustChangePassword =
            AccessRules.Level(state.User)
                == AccessLevel.PasswordChangeRequired;

        // 2. B51: Tương thích với các URL Dashboard cũ.
        // Chỉ chuyển hướng khi phiên hợp lệ và có bộ lọc.
        var query = new Uri(Nav.Uri).Query;

        if (canUseApp && query.Length > 0)
        {
            var filters =
                Microsoft.AspNetCore.WebUtilities
                    .QueryHelpers.ParseQuery(query);

            var hasDashboardFilter = filters.Keys.Any(key =>
                key.Equals(
                    "jobId",
                    StringComparison.OrdinalIgnoreCase)
                ||
                key.Equals(
                    "from",
                    StringComparison.OrdinalIgnoreCase)
                ||
                key.Equals(
                    "to",
                    StringComparison.OrdinalIgnoreCase));

            if (hasDashboardFilter)
            {
                redirecting = true;

                Nav.NavigateTo(
                    "/dashboard" + query,
                    replace: true);

                return;
            }
        }

        // 3. B52: Đọc cấu hình đăng ký công khai.
        // Chỉ gọi API khi người dùng chưa có quyền
        // sử dụng ứng dụng và không bị buộc đổi mật khẩu.
        var registrationEnabled =
            !canUseApp
            && !mustChangePassword
            && await PublicSettings.IsRegistrationEnabledAsync();

        // 4. Xác định CTA phù hợp theo trạng thái.
        // Không dẫn tới /register khi route chưa tồn tại.
        cta = PublicCta.Resolve(
            canUseApp,
            mustChangePassword,
            registrationEnabled,
            PublicCta.RegisterRouteAvailable,
            AccessRules.IsAdmin(state.User));

        // 5. Hiển thị trang giới thiệu.
        ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ready || redirecting || effectsRequested || disposed) return;
        effectsRequested = true;   // chỉ khởi tạo một lần

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/landing-refinement.js");
            if (disposed || module is null) return;
            effects = await module.InvokeAsync<IJSObjectReference>("init", pageRoot);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException
            or InvalidOperationException or TaskCanceledException)
        {
            // Không có hiệu ứng thì trang vẫn dùng được đầy đủ.
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        try
        {
            if (effects is not null)
            {
                await effects.InvokeVoidAsync("dispose");
                await effects.DisposeAsync();
            }
            if (module is not null) await module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // Circuit đã đóng: trình duyệt tự dọn dẹp.
        }
    }
}

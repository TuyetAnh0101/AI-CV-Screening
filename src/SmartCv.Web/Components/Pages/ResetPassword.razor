@page "/reset-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@implements IDisposable
@inject IAuthRecoveryApi RecoveryApi
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TimeProvider Clock

<PageTitle>Đặt lại mật khẩu · SCApp</PageTitle>
<HeadContent><meta name="referrer" content="no-referrer" /></HeadContent>

<div class="b54-recovery">
    <div class="b54-path"><span>SCApp</span><span aria-hidden="true">/</span><span>Đặt lại mật khẩu</span></div>
    <section class="b54-card" aria-labelledby="b54-reset-title">
        <header class="b54-heading">
            <span class="b54-emblem" aria-hidden="true">✧</span>
            <span class="b54-step">02 / 02</span>
            <p class="b54-eyebrow">Tài khoản &amp; bảo mật</p>
            <h1 id="b54-reset-title">Tạo mật khẩu mới</h1>
            <p class="b54-lead">Chọn mật khẩu khác mật khẩu cũ. Khi hoàn tất, các phiên đăng nhập trước đây sẽ hết hiệu lực.</p>
        </header>

        @if (!prepared)
        {
            <div class="b54-message is-info" role="status"><span class="b54-spinner is-teal" aria-hidden="true"></span><span>Đang bảo vệ liên kết đặt lại mật khẩu…</span></div>
        }
        else if (securityFailure)
        {
            <div class="b54-message is-error" role="alert">Không thể bảo vệ liên kết trên trình duyệt này. Hãy mở lại bằng trình duyệt hỗ trợ JavaScript và thử lại.</div>
            <a class="btn sc-btn-primary b54-submit" href="/forgot-password">Yêu cầu liên kết mới</a>
        }
        else
        {
            @if (form.FormError is { } message)
            {
                <div class="b54-message @(form.ExpiredToken || form.InvalidToken ? "is-info" : "is-error")" role="alert" tabindex="-1" @ref="noticeRef">
                    <span class="b54-message-mark" aria-hidden="true">!</span><div><strong>Chưa thể đặt mật khẩu</strong><p>@message</p></div>
                </div>
            }

            @if (form.ExpiredToken || form.InvalidToken || form.Unresolved)
            {
                <div class="b54-actions">
                    @if (form.Unresolved)
                    {
                        <a class="btn sc-btn-primary b54-submit" href="/login">Thử đăng nhập bằng mật khẩu mới</a>
                    }
                    <a class="btn sc-btn-secondary b54-secondary" href="/forgot-password">Yêu cầu liên kết mới</a>
                </div>
            }
            else
            {
                <form class="b54-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate aria-busy="@(form.Submitting ? "true" : "false")">
                    <PasswordInput @ref="newInput" Id="b54-new-password" Label="Mật khẩu mới" Autocomplete="new-password"
                                   Value="@form.NewPassword" ValueChanged="v => form.NewPassword = v"
                                   Show="@form.ShowNew" ShowChanged="v => form.ShowNew = v"
                                   Error="@form.NewError" ReadOnly="@(!form.CanSubmit)" ExtraDescribedBy="b54-password-rules" />
                    <ul id="b54-password-rules" class="b54-rules" aria-label="Yêu cầu mật khẩu mới">
                        @foreach (var rule in form.Rules)
                        {
                            <li class="@(rule.Met ? "is-met" : "")">
                                <span aria-hidden="true">@(rule.Met ? "✓" : "○")</span><span>@rule.Text</span>
                            </li>
                        }
                    </ul>
                    <PasswordInput @ref="confirmInput" Id="b54-confirm-password" Label="Nhập lại mật khẩu mới" Autocomplete="new-password"
                                   Value="@form.ConfirmPassword" ValueChanged="v => form.ConfirmPassword = v"
                                   Show="@form.ShowConfirm" ShowChanged="v => form.ShowConfirm = v"
                                   Error="@form.ConfirmError" ReadOnly="@(!form.CanSubmit)" />
                    <div class="b54-security-hint"><span aria-hidden="true">✦</span><span>Liên kết có hiệu lực 30 phút và chỉ dùng được một lần.</span></div>
                    <button type="submit" class="btn sc-btn-primary b54-submit" disabled="@(!form.CanSubmit)">
                        @if (form.Submitting)
                        {
                            <span class="b54-spinner" aria-hidden="true"></span><span>Đang cập nhật mật khẩu…</span>
                        }
                        else if (form.RetrySecondsLeft > 0)
                        {
                            <span>Thử lại sau @form.RetrySecondsLeft giây</span>
                        }
                        else
                        {
                            <span>Đặt mật khẩu mới</span><span aria-hidden="true">→</span>
                        }
                    </button>
                </form>
            }
        }
        <div class="b54-footer"><a href="/login">← Quay lại đăng nhập</a><span>Kết nối bảo mật SCApp</span></div>
    </section>
    <p class="b54-outside-note">Bạn không cần liên hệ Admin để đặt lại mật khẩu. Không chia sẻ liên kết trong email với người khác.</p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    private ResetPasswordFlow form = default!;
    private string? resetToken;
    private bool prepared;
    private bool securityFailure;
    private bool focusNew;
    private bool focusConfirm;
    private bool focusNotice;
    private PasswordInput? newInput, confirmInput;
    private ElementReference noticeRef;
    private System.Threading.Timer? ticker;
    private readonly CancellationTokenSource lifetime = new();

    protected override void OnInitialized()
    {
        form = new ResetPasswordFlow(Clock);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Cất vào bộ nhớ riêng của circuit, sau đó XÓA query khỏi lịch sử trước khi hiển thị form / gọi API.
            var received = Token;
            try
            {
                await JS.InvokeVoidAsync("history.replaceState", null, "", Nav.ToAbsoluteUri("/reset-password").AbsoluteUri);
                resetToken = ResetPasswordFlow.LooksLikeToken(received) ? received : null;
                Token = null;
                if (resetToken is null) form.MissingOrInvalidLink();
                else focusNew = true;
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
            {
                securityFailure = true;
                resetToken = null;
                Token = null;
            }
            finally
            {
                prepared = true;
                StateHasChanged();
            }
            return;
        }
        if (!prepared || securityFailure) return;
        try
        {
            if (focusNew && newInput is not null)
            {
                focusNew = false;
                await newInput.FocusAsync();
            }
            else if (focusConfirm && confirmInput is not null)
            {
                focusConfirm = false;
                await confirmInput.FocusAsync();
            }
            else if (focusNotice && form.FormError is not null)
            {
                focusNotice = false;
                await noticeRef.FocusAsync();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException) { }
    }

    private void StartTicker()
    {
        ticker?.Dispose();
        ticker = new System.Threading.Timer(_ =>
        {
            if (lifetime.IsCancellationRequested) return;
            _ = InvokeAsync(() =>
            {
                StateHasChanged();
                if (form.RetrySecondsLeft == 0) { ticker?.Dispose(); ticker = null; }
            });
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task SubmitAsync()
    {
        if (!prepared || securityFailure || resetToken is null) return;
        try
        {
            var outcome = await form.SubmitAsync(RecoveryApi, resetToken, lifetime.Token);
            if (outcome == ResetPasswordOutcome.Changed)
            {
                resetToken = null;
                Nav.NavigateTo("/login?reset=1", replace: true);
                return;
            }
            if (outcome is ResetPasswordOutcome.Invalid or ResetPasswordOutcome.Expired or ResetPasswordOutcome.Unknown)
            {
                resetToken = null;
                focusNotice = true;
            }
            else if (outcome == ResetPasswordOutcome.RateLimited && form.RetrySecondsLeft > 0)
            {
                StartTicker();
                focusNotice = true;
            }
            else if (form.NewError is not null) focusNew = true;
            else if (form.ConfirmError is not null) focusConfirm = true;
            else if (form.FormError is not null) focusNotice = true;
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        ticker?.Dispose();
        lifetime.Cancel(); lifetime.Dispose();
        resetToken = null;
        form?.ClearSecrets();
    }
}

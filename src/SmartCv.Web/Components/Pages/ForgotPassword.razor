@page "/forgot-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@implements IDisposable
@inject IAuthRecoveryApi RecoveryApi
@inject TimeProvider Clock

<PageTitle>Quên mật khẩu · SCApp</PageTitle>

<div class="b54-recovery">
    <div class="b54-path"><span>SCApp</span><span aria-hidden="true">/</span><span>Khôi phục tài khoản</span></div>
    <section class="b54-card" aria-labelledby="b54-forgot-title">
        <header class="b54-heading">
            <span class="b54-emblem" aria-hidden="true">✉</span>
            <span class="b54-step">01 / 02</span>
            <p class="b54-eyebrow">Tài khoản &amp; bảo mật</p>
            <h1 id="b54-forgot-title">Quên mật khẩu?</h1>
            <p class="b54-lead">Nhập email đăng nhập của bạn. Nếu email có tài khoản SCApp, hệ thống sẽ gửi liên kết đặt lại mật khẩu có hiệu lực trong 30 phút.</p>
        </header>

        @if (form.Accepted)
        {
            <div class="b54-message is-success" role="status" aria-live="polite">
                <span class="b54-message-mark" aria-hidden="true">✓</span>
                <div>
                    <strong>Đã tiếp nhận yêu cầu</strong>
                    <p>@ForgotPasswordFlow.GenericAccepted</p>
                    <p>Không thấy thư? Kiểm tra thư rác hoặc thử lại khi hết thời gian chờ.</p>
                </div>
            </div>
        }
        @if (form.FormError is { } message)
        {
            <div class="b54-message is-error" role="alert" tabindex="-1" @ref="noticeRef">
                <span aria-hidden="true">!</span><span>@message</span>
            </div>
        }

        <form class="b54-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate aria-busy="@(form.Submitting ? "true" : "false")">
            <div class="b54-field">
                <label for="b54-email">Địa chỉ email</label>
                <div class="b54-input-wrap">
                    <span aria-hidden="true" class="b54-input-icon">@@</span>
                    <input id="b54-email" @ref="emailRef" class="sc-input" type="email" name="email"
                           autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false"
                           maxlength="254" placeholder="ban@congty.vn" readonly="@form.Submitting"
                           @bind="form.Email" @bind:event="oninput"
                           aria-invalid="@(form.EmailError is null ? "false" : "true")"
                           aria-describedby="@(form.EmailError is null ? "b54-email-hint" : "b54-email-error b54-email-hint")" />
                </div>
                <p id="b54-email-hint" class="b54-helper">Để bảo vệ thông tin, câu trả lời không xác nhận email có tài khoản hay không.</p>
                @if (form.EmailError is { } error)
                {
                    <p id="b54-email-error" class="b54-field-error" role="alert">@error</p>
                }
            </div>

            <button type="submit" class="btn sc-btn-primary b54-submit" disabled="@(!form.CanSubmit)">
                @if (form.Submitting)
                {
                    <span class="b54-spinner" aria-hidden="true"></span><span>Đang gửi yêu cầu…</span>
                }
                else if (form.RetrySecondsLeft > 0)
                {
                    <span>Gửi lại sau @form.RetrySecondsLeft giây</span>
                }
                else
                {
                    <span>Gửi hướng dẫn</span><span aria-hidden="true">→</span>
                }
            </button>
        </form>
        <div class="b54-footer"><a href="/login">← Quay lại đăng nhập</a><span>Liên kết chỉ sử dụng một lần</span></div>
    </section>
    <p class="b54-outside-note">SCApp không bao giờ yêu cầu gửi mật khẩu qua email hoặc tin nhắn.</p>
</div>

@code {
    private ForgotPasswordFlow form = default!;
    private ElementReference emailRef, noticeRef;
    private bool focusError;
    private System.Threading.Timer? ticker;
    private readonly CancellationTokenSource lifetime = new();

    protected override void OnInitialized()
    {
        form = new ForgotPasswordFlow(Clock);
    }

    private async Task SubmitAsync()
    {
        try
        {
            var outcome = await form.SubmitAsync(RecoveryApi, lifetime.Token);
            focusError = outcome is ForgotPasswordOutcome.NotSent or ForgotPasswordOutcome.RateLimited or ForgotPasswordOutcome.Failed;
            if (form.RetrySecondsLeft > 0) StartTicker();
        }
        catch (OperationCanceledException) { }
    }

    private void StartTicker()
    {
        ticker?.Dispose();
        ticker = new System.Threading.Timer(_ =>
        {
            if (lifetime.IsCancellationRequested) return;
            _ = InvokeAsync(() =>
            {
                StateHasChanged();
                if (form.RetrySecondsLeft == 0) { ticker?.Dispose(); ticker = null; }
            });
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender || (focusError && form.EmailError is not null))
            {
                focusError = false;
                await emailRef.FocusAsync();
            }
            else if (focusError && form.FormError is not null)
            {
                focusError = false;
                await noticeRef.FocusAsync();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException) { }
    }

    public void Dispose()
    {
        ticker?.Dispose();
        lifetime.Cancel(); lifetime.Dispose();
        if (form is not null) form.Email = "";
    }
}

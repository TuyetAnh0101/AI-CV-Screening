@page "/upload"
@*
    Trang "Tải lên & Phân tích CV" (Figma Project_GD, node 375:1982 "Gán CV vào Job").
    B3 (đã làm): ô kéo thả, tải lên ngay qua POST /api/cvs/upload (A4–A6), danh sách CV, ô tích, menu ⋯, nút Hủy.
    B4 (đã làm): chọn công việc thật và hiển thị yêu cầu.
    B5: kiểm tra file trên giao diện (UploadValidator), hiện lỗi từng dòng, tổng kết, xóa file lỗi, báo mất kết nối API.
    B6: nút "Phân tích hồ sơ" → POST /api/applications (A8) → POST /api/runs → /upload?runId=N;
        thẻ "Phân tích hồ sơ" hỏi GET /api/runs/{id} mỗi 2 giây tới khi Completed/Failed (RunProgressPanel).
*@
@implements IAsyncDisposable
@using Microsoft.Extensions.Options
@using SmartCv.Core.Options
@inject CvApiClient CvApi
@inject JobApiClient JobApi
@inject ApplicationApiClient ApplicationApi
@inject RunApiClient RunApi
@inject NavigationManager Nav
@inject IOptions<CvUploadOptions> UploadOptions
@inject IConfiguration Configuration
@inject ILogger<Upload> Logger

<PageTitle>Tải lên & Phân tích CV · SCApp</PageTitle>

@* ---------- Banner tiêu đề (Figma: nền chuyển màu #E6FFFB → #E0F2FE) ---------- *@
<section class="page-banner">
    <h1>Tải lên &amp; Phân tích CV</h1>
    <p>Quản lý hồ sơ, gán công việc và đánh giá mức độ phù hợp bằng AI</p>
</section>

@* ---------- 2 thẻ: Tải nhiều hồ sơ | Phân tích hồ sơ ---------- *@
<nav class="page-tabs" role="tablist">
    <button type="button" role="tab" aria-selected="@(tab == Tab.Upload ? "true" : "false")"
            class="tab @(tab == Tab.Upload ? "active" : null)" @onclick="() => tab = Tab.Upload">
        Tải nhiều hồ sơ
        @if (items.Count > 0) { <span class="tab-count">@items.Count</span> }
    </button>
    <button type="button" role="tab" aria-selected="@(tab == Tab.Analyze ? "true" : "false")"
            class="tab @(tab == Tab.Analyze ? "active" : null)" @onclick="() => tab = Tab.Analyze">
        Phân tích hồ sơ
        @if (run is not null && !RunFlow.IsFinished(run.Status))
        {
            <span class="tab-dot" aria-hidden="true"></span>
            <span class="visually-hidden">(đang phân tích)</span>
        }
    </button>
</nav>

<section class="page-card">
    @if (tab == Tab.Upload)
    {
        @* B5: lỗi của cả lần tải (mất kết nối API, máy chủ lỗi) – khác lỗi từng file hiện trong bảng *@
        <ErrorAlert Title="@(uploadError?.Title ?? string.Empty)" Message="@uploadError?.Message" />

        @* B6: không phân tích được (chưa chọn job / CV, API gắn CV hoặc tạo lượt lỗi) *@
        <ErrorAlert Title="@(analyzeError?.Title ?? string.Empty)" Message="@analyzeError?.Message" />

        @* B5: thông báo tổng kết sau mỗi lần tải *@
        @if (notice is not null)
        {
            <div class="alert d-flex justify-content-between align-items-start gap-2 sc-notice @(noticeHasErrors ? "is-warn" : "is-ok")"
                 role="status" aria-live="polite">
                <span class="sc-notice-text">
                    <span class="sc-notice-icon" aria-hidden="true">@(noticeHasErrors ? "!" : "✓")</span>
                    <span>@notice</span>
                </span>
                <button type="button" class="btn-close" aria-label="Đóng thông báo" @onclick="() => notice = null"></button>
            </div>
        }

        @* ---------- B4: Chọn công việc và yêu cầu tuyển dụng ---------- *@
        <div class="field">
            <label for="job" class="field-label">Chọn công việc</label>
            <select id="job" class="sc-select @(jobInvalid ? "is-invalid" : null)" @bind="selectedJobId" @bind:after="OnJobChanged"
                    disabled="@(loadingJobs || jobs.Count == 0 || analyzing)"
                    aria-invalid="@(jobInvalid ? "true" : "false")"
                    aria-describedby="job-details" aria-busy="@(loadingJobs ? "true" : "false")">
                <option value="">@(loadingJobs ? "Đang tải công việc..." : "Chọn công việc")</option>
                @foreach (var job in jobs)
                {
                    <option value="@job.JobId">@job.Title</option>
                }
            </select>
            <div id="job-details" aria-live="polite">
                @if (jobInvalid)
                {
                    <div class="field-error">Hãy chọn công việc trước khi phân tích.</div>
                }
                @if (jobsError is not null)
                {
                    <div class="field-error" role="alert">
                        @jobsError
                        <button type="button" class="btn btn-link btn-sm" @onclick="LoadJobsAsync">Thử lại</button>
                    </div>
                }
                else if (!loadingJobs && jobs.Count == 0)
                {
                    <div class="job-hint">Chưa có công việc đang tuyển.</div>
                }
                else if (SelectedJob is { } selectedJob)
                {
                    <div class="job-hint">
                        <span>Kỹ năng bắt buộc:</span>
                        @foreach (var skill in selectedJob.Skills.Where(s => s.SkillType == SmartCv.Core.Constants.SkillTypes.MustHave))
                        {
                            <span class="skill-chip">@skill.DisplayName</span>
                        }
                        @if (!selectedJob.Skills.Any(s => s.SkillType == SmartCv.Core.Constants.SkillTypes.MustHave))
                        {
                            <span>Không yêu cầu</span>
                        }
                        <span>• @(selectedJob.MinGpa is { } gpa ? $"GPA tối thiểu {gpa.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}" : "Không yêu cầu GPA")</span>
                        <span>• Kinh nghiệm từ @selectedJob.MinYearsExperience.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) năm</span>
                    </div>
                }
            </div>
        </div>

        @* ---------- B3: Ô kéo thả ---------- *@
        <div class="field">
            <CvDropzone OnFilesSelected="OnFilesSelectedAsync" Disabled="busy" Accept="@AcceptAttr" Caption="@Caption" />
        </div>

        @* ---------- B3: Danh sách CV ---------- *@
        <div class="field">
            <div class="field-label d-flex justify-content-between flex-wrap gap-2">
                <span>Danh sách CV</span>
                @if (items.Count > 0)
                {
                    <span class="list-summary" aria-live="polite">
                        Sẵn sàng <strong>@items.Count(i => i.CanAnalyze)</strong>
                        • Đã chọn <strong>@SelectedCount</strong>
                        @if (ErrorCount > 0)
                        {
                            <span class="summary-error"> • Lỗi <strong>@ErrorCount</strong></span>
                        }
                    </span>
                }
            </div>
            <CvFileTable Items="items" ApiBaseUrl="@apiBaseUrl"
                         OnRemove="RemoveItem" OnToggle="ToggleItem" OnToggleAll="ToggleAll" />
            @if (ErrorCount > 0)
            {
                @* B5: chỉ bỏ các dòng lỗi khỏi màn hình; không gọi API, không xóa gì trên máy chủ *@
                <button type="button" class="btn btn-sm sc-btn-remove-errors" @onclick="RemoveErrors">
                    <span aria-hidden="true">✕</span> Xóa @ErrorCount file lỗi khỏi danh sách
                </button>
            }
        </div>

        @* ---------- Nút (Figma: Hủy | Phân tích hồ sơ) ---------- *@
        <div class="page-actions">
            <button type="button" class="btn sc-btn-secondary" @onclick="Reset" disabled="@(items.Count == 0 || analyzing)">Hủy</button>
            @* B6: khóa trong lúc tải lên / đang phân tích để không tạo request trùng *@
            <button type="button" class="btn sc-btn-primary sc-btn-analyze" @onclick="AnalyzeAsync"
                    disabled="@(busy || analyzing)" aria-busy="@(analyzing ? "true" : "false")"
                    title="@(busy ? "Đang tải CV lên, vui lòng chờ" : null)">
                @if (analyzing)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    <span role="status">@analyzeStep</span>
                }
                else
                {
                    <span>Phân tích hồ sơ</span>
                    @if (SelectedCount > 0) { <span class="analyze-count">@SelectedCount</span> }
                }
            </button>
        </div>
    }
    else
    {
        @* ---------- B6: Tiến độ phân tích ---------- *@
        <RunProgressPanel Run="run" RunId="trackedRunId" Loading="runLoading" NotFound="runNotFound"
                          Error="@runError" Notice="@runNotice" Polling="polling" LastUpdated="runUpdatedAt"
                          OnRetry="RetryRunAsync" OnBackToUpload="() => tab = Tab.Upload" />
    }
</section>

@code {
    private enum Tab { Upload, Analyze }

    private Tab tab = Tab.Upload;
    private readonly List<UploadItem> items = [];
    private bool busy;              // đang tải lên: khóa ô kéo thả để IBrowserFile cũ không bị thay thế giữa chừng
    private string? notice;
    private bool noticeHasErrors;
    private (string Title, string Message)? uploadError;   // B5: lỗi của cả request (kết nối, máy chủ)
    private int generation;        // tăng khi bấm Hủy: kết quả của lần tải cũ không ghi đè thông báo mới
    private string? apiBaseUrl;
    private List<JobDto> jobs = [];
    private int? selectedJobId;
    private bool loadingJobs = true;
    private string? jobsError;
    private JobDto? SelectedJob => jobs.FirstOrDefault(j => j.JobId == selectedJobId);

    // ---------- B6: phân tích hồ sơ ----------
    /// <summary>/upload?runId=N: mở thẳng thẻ tiến độ của lượt N (F5 hoặc gửi đường dẫn vẫn đúng lượt).</summary>
    [SupplyParameterFromQuery(Name = "runId")] public int? RunId { get; set; }

    private bool analyzing;                                 // đang gắn CV / tạo lượt: khóa nút, chặn bấm lặp
    private string analyzeStep = string.Empty;
    private (string Title, string Message)? analyzeError;
    private bool jobInvalid;

    private RunProgressDto? run;
    private int? trackedRunId;                              // lượt đang theo dõi (khớp ?runId)
    private bool runLoading;
    private bool runNotFound;
    private bool polling;
    private string? runError;
    private string? runNotice;
    private DateTime? runUpdatedAt;
    private CancellationTokenSource? pollCts;               // mỗi lượt theo dõi một CTS; đổi lượt / rời trang thì hủy

    // Mặc định 2 giây. Khóa "RunProgress:PollIntervalMs" chỉ để test chạy nhanh, không cần đặt trong appsettings.
    private TimeSpan PollInterval => TimeSpan.FromMilliseconds(Math.Clamp(Configuration.GetValue("RunProgress:PollIntervalMs", 2000), 20, 60_000));

    private CvUploadOptions Limits => UploadOptions.Value;
    private int MaxFilesPerSelection => Math.Max(1, Configuration.GetValue("CvUpload:MaxFilesPerSelection", Limits.MaxFilesPerRequest));
    // ConfigurationBinder NỐI mảng trong appsettings vào mảng mặc định của CvUploadOptions → phải bỏ trùng.
    private IEnumerable<string> Extensions => Limits.AllowedExtensions.Select(e => e.ToLowerInvariant()).Distinct();
    private string AcceptAttr => string.Join(",", Extensions);
    private int SelectedCount => items.Count(i => i.CanAnalyze && i.Selected);
    private int ErrorCount => items.Count(i => i.IsError);

    // Figma: "PDF, JPG, PNG • Tối đa 25 CV/lần • Tối đa 2 MB/tệp". Số lấy từ cấu hình CvUpload, không viết cứng.
    private string Caption =>
        $"{string.Join(", ", Extensions.Select(e => e.TrimStart('.').ToUpperInvariant()).Where(e => e != "JPEG"))}"
        + $"  •  Tối đa {MaxFilesPerSelection} CV/lần  •  Tối đa {Limits.MaxFileSizeMB} MB/tệp";

    protected override async Task OnInitializedAsync()
    {
        var url = Configuration["ApiBaseUrl"];
        apiBaseUrl = string.IsNullOrWhiteSpace(url) ? null : url.EndsWith('/') ? url : url + "/";
        await LoadJobsAsync();
    }

    private async Task LoadJobsAsync()
    {
        loadingJobs = true;
        jobsError = null;
        try
        {
            var result = await JobApi.GetJobsAsync();
            jobs = result.IsSuccess ? result.Data!.Where(j => j.IsActive).ToList() : [];
            jobsError = result.IsSuccess ? null : result.ErrorMessage;
            if (SelectedJob is null) selectedJobId = null;
        }
        finally
        {
            loadingJobs = false;
        }
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        if (busy) return;   // ô đã bị khóa; chặn thêm một lần cho chắc
        notice = null;
        uploadError = null;

        // GetMultipleFiles mặc định chỉ cho 10 file và NÉM LỖI nếu nhiều hơn; lấy rộng rồi tự áp giới hạn.
        var picked = e.GetMultipleFiles(maximumFileCount: 1000);
        var validator = new UploadValidator(Limits, MaxFilesPerSelection);
        var toUpload = new List<(IBrowserFile File, UploadItem Item)>();
        var skipped = 0;

        foreach (var file in picked)
        {
            var item = new UploadItem { FileName = file.Name, SizeBytes = file.Size, Selected = true };
            // B5 lớp 1: kiểm tra trên giao diện (không đọc nội dung). API A5 vẫn kiểm tra lại nội dung thật.
            // items đã chứa các file hợp lệ vừa thêm ở vòng trước → bắt được cả file trùng trong cùng lần thả.
            var error = validator.Validate(file.Name, file.Size, items, toUpload.Count);
            if (error is not null)
            {
                Invalidate(item, error);
                skipped++;
            }
            else
            {
                item.State = UploadItemState.Uploading;
                toUpload.Add((file, item));
            }

            items.Add(item);
        }

        if (toUpload.Count == 0)
        {
            if (skipped > 0) (notice, noticeHasErrors) = UploadFlow.Summarize([], skipped);
            return;
        }

        busy = true;
        var myGeneration = generation;
        StateHasChanged();   // hiện ngay các dòng "Đang tải lên"

        try
        {
            // API nhận tối đa MaxFilesPerRequest file / request và MaxRequestBytes / request: chia nhóm, gửi lần lượt.
            var batches = UploadFlow.SplitIntoBatches(toUpload, x => x.File.Size,
                Math.Max(1, Limits.MaxFilesPerRequest), Limits.MaxRequestBytes - 1024 * 1024);

            foreach (var batch in batches)
            {
                ApiResult<CvUploadResponse> result;
                (string Title, string Message)? batchError;
                try
                {
                    result = await CvApi.UploadAsync(batch.Select(b => b.File).ToList());
                    batchError = UploadFlow.DescribeBatchFailure(result);
                }
                catch (Exception ex) when (ex is IOException or InvalidOperationException or HttpRequestException
                                               or TimeoutException or Microsoft.JSInterop.JSException)
                {
                    // Ví dụ: file trên trình duyệt không đọc được nữa (JSException), không nhận được dữ liệu file
                    // (TimeoutException), mất kết nối giữa chừng. Chỉ nhóm này lỗi; nhóm đã xong giữ nguyên, circuit không chết.
                    Logger.LogWarning(ex, "Không đọc/gửi được nhóm {Count} file", batch.Count);
                    result = ApiResult<CvUploadResponse>.Failure("Không đọc hoặc gửi được file. Vui lòng chọn lại file.");
                    batchError = ("Không đọc hoặc gửi được file",
                        "Trình duyệt không còn cho đọc file đã chọn hoặc kết nối bị gián đoạn. Vui lòng chọn lại file.");
                }

                // B5: chỉ giữ lỗi đầu tiên trên khung đầu thẻ; lý do từng file vẫn hiện trong bảng.
                if (batchError is not null && uploadError is null && myGeneration == generation) uploadError = batchError;
                UploadFlow.ApplyResult(batch.Select(b => b.Item).ToList(), result);
                StateHasChanged();   // cập nhật từng nhóm, nhóm đã xong không bị mất khi nhóm sau lỗi
            }
        }
        finally
        {
            busy = false;
        }

        if (myGeneration == generation)
        {
            (notice, noticeHasErrors) = UploadFlow.Summarize(toUpload.Select(x => x.Item).ToList(), skipped);
        }
    }

    // B5 "Xóa N file lỗi khỏi danh sách": chỉ bỏ dòng Lỗi file / Bị từ chối trên giao diện, không gọi API.
    private void RemoveErrors()
    {
        items.RemoveAll(i => i.IsError);
        uploadError = null;
    }

    private static void Invalidate(UploadItem item, string message)
    {
        item.State = UploadItemState.Invalid;
        item.Selected = false;
        item.Message = message;
    }

    // "Xóa khỏi danh sách": chỉ bỏ dòng trên giao diện; CV đã lưu trên máy chủ và database giữ nguyên.
    private void RemoveItem(UploadItem item)
    {
        if (item.State == UploadItemState.Uploading) return;   // tránh lệch trạng thái khi request đang chạy
        items.Remove(item);
    }

    private void ToggleItem((UploadItem Item, bool Selected) e)
    {
        if (e.Item.CanAnalyze) e.Item.Selected = e.Selected;
    }

    private void ToggleAll(bool selected)
    {
        foreach (var item in items.Where(i => i.CanAnalyze)) item.Selected = selected;
    }

    // "Hủy": xóa danh sách trên giao diện. Không gọi API xóa, không hủy request đang chạy
    // (request đó vẫn hoàn tất trên máy chủ; kết quả chỉ cập nhật vào các dòng đã bị bỏ, không hiện lại).
    private void Reset()
    {
        generation++;
        items.Clear();
        notice = null;
        uploadError = null;
        analyzeError = null;
        jobInvalid = false;
    }

    // =====================================================================
    // B6: "Phân tích hồ sơ" = gắn CV vào job (A8) → tạo lượt (POST /api/runs) → theo dõi tiến độ
    // =====================================================================

    private void OnJobChanged()
    {
        jobInvalid = false;
        if (analyzeError is not null && SelectedJob is not null) analyzeError = null;
    }

    private async Task AnalyzeAsync()
    {
        if (analyzing || busy) return;   // chặn bấm lặp: kiểm tra trước lần await đầu tiên

        analyzeError = null;
        jobInvalid = false;
        if (RunFlow.ValidateAnalyze(SelectedJob, items) is { } invalid)
        {
            jobInvalid = invalid.JobMissing;
            analyzeError = (invalid.JobMissing ? "Chưa chọn công việc" : "Chưa thể phân tích", invalid.Message);
            return;
        }

        analyzing = true;
        analyzeStep = "Đang gắn CV vào công việc...";
        try
        {
            // 1. Gắn CV đã chọn vào job. Gọi lại an toàn: CV đã gắn trả AlreadyExists kèm ApplicationId cũ.
            var assign = await ApplicationApi.AssignSelectedAsync(SelectedJob, items);
            if (!assign.IsSuccess || assign.Data is null)
            {
                analyzeError = ("Không gắn được CV vào công việc",
                    RunFlow.FailureMessage(assign, "Máy chủ gặp lỗi khi gắn CV vào công việc. Vui lòng thử lại sau."));
                return;
            }

            var (applicationIds, notFound) = RunFlow.ApplicationIdsFrom(assign.Data);
            if (applicationIds.Count == 0)
            {
                analyzeError = ("Không gắn được CV vào công việc",
                    "Không CV nào gắn được vào công việc (CV có thể không còn trên máy chủ). Hãy tải lại CV rồi thử lại.");
                return;
            }

            // 2. Tạo lượt phân tích
            analyzeStep = "Đang tạo lượt phân tích...";
            StateHasChanged();
            var start = await RunApi.StartAsync(applicationIds);
            if (!start.IsSuccess || start.Data is null)
            {
                analyzeError = ("Không tạo được lượt phân tích",
                    RunFlow.FailureMessage(start, "Máy chủ gặp lỗi khi tạo lượt phân tích. Vui lòng thử lại sau.")
                    + " CV đã được gắn vào công việc; bấm \"Phân tích hồ sơ\" lần nữa để thử lại.");
                return;
            }

            // 3. Ghi runId lên địa chỉ: OnParametersSet sẽ mở thẻ tiến độ và bắt đầu hỏi API
            run = start.Data;
            runNotice = notFound > 0
                ? $"{notFound} CV không còn trên máy chủ nên không được đưa vào lượt phân tích."
                : null;
            Nav.NavigateTo($"upload?runId={run.RunId}");
        }
        finally
        {
            analyzing = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (RunId == trackedRunId) return;

        if (RunId is > 0 and var id) StartTracking(id);
        else if (RunId is not null)
        {
            // ?runId=0 hoặc số âm: không gọi API, báo không tìm thấy
            StopTracking();
            run = null;
            trackedRunId = RunId;
            runNotFound = true;
            runLoading = false;
            tab = Tab.Analyze;
        }
        else
        {
            // Quay lại /upload (không có runId): dừng theo dõi, về thẻ tải hồ sơ, giữ danh sách CV
            StopTracking();
            trackedRunId = null;
            run = null;
            runError = runNotice = null;
            runNotFound = runLoading = false;
            tab = Tab.Upload;
        }
    }

    private void StartTracking(int runId)
    {
        StopTracking();
        var keepCreated = run?.RunId == runId;   // vừa tạo: hiện ngay kết quả của POST, không chờ lần hỏi đầu
        if (!keepCreated) { run = null; runNotice = null; }
        trackedRunId = runId;
        tab = Tab.Analyze;
        runNotFound = false;
        runError = null;
        runUpdatedAt = keepCreated ? DateTime.UtcNow : null;
        runLoading = !keepCreated;

        // Lúc prerender chưa tương tác được: không hỏi API, trang tương tác sẽ bắt đầu lại.
        if (!RendererInfo.IsInteractive) return;

        var cts = new CancellationTokenSource();
        pollCts = cts;
        polling = true;
        _ = PollLoopAsync(runId, cts);
    }

    private void StopTracking()
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
        pollCts = null;
        polling = false;
    }

    /// <summary>
    /// Hỏi GET /api/runs/{id} cho tới khi lượt kết thúc, không tồn tại, đổi lượt khác hoặc rời trang.
    /// Mỗi vòng gắn với CTS riêng: kết quả trả về muộn của lượt cũ bị bỏ, không ghi đè lượt mới.
    /// Lỗi kết nối / máy chủ: giữ dữ liệu cũ, báo lỗi và thử lại thưa dần (tối đa 5 lần khoảng thường).
    /// </summary>
    private async Task PollLoopAsync(int runId, CancellationTokenSource cts)
    {
        var ct = cts.Token;
        var failures = 0;
        try
        {
            while (true)
            {
                var result = await RunApi.GetRunAsync(runId, ct);
                if (ct.IsCancellationRequested || pollCts != cts) return;

                runLoading = false;
                var stop = false;
                if (result.IsSuccess && result.Data is { } data && data.RunId == runId)
                {
                    run = data;
                    runError = null;
                    runUpdatedAt = DateTime.UtcNow;
                    failures = 0;
                    stop = RunFlow.IsFinished(data.Status);
                }
                else if (result.StatusCode == 404)
                {
                    run = null;
                    runNotFound = true;
                    runError = null;
                    stop = true;
                }
                else
                {
                    failures++;
                    runError = result.StatusCode >= 500
                        ? "Máy chủ API đang gặp lỗi."
                        : result.ErrorMessage ?? "Không lấy được tiến độ phân tích.";
                }

                if (stop) polling = false;
                await InvokeAsync(StateHasChanged);
                if (stop) return;

                await Task.Delay(PollInterval * Math.Min(failures + 1, 5), ct);
            }
        }
        catch (OperationCanceledException)
        {
            // đổi lượt khác hoặc rời trang
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Dừng theo dõi tiến độ lượt {RunId} do lỗi không mong muốn", runId);
            if (pollCts == cts && !ct.IsCancellationRequested)
            {
                polling = false;
                runLoading = false;
                runError = "Không cập nhật được tiến độ. Bấm \"Thử lại ngay\" để tiếp tục.";
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    /// <summary>"Thử lại ngay": khởi động lại vòng hỏi (hủy vòng cũ trước, nên không bao giờ có hai vòng song song).</summary>
    private Task RetryRunAsync()
    {
        if (trackedRunId is > 0 and var id) StartTracking(id);   // giữ dữ liệu cũ của cùng lượt trong lúc chờ
        return Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        StopTracking();
        return ValueTask.CompletedTask;
    }
}

@page "/login"
@*
    B27: đăng nhập thật qua A28 (POST /api/auth/login). Bố cục riêng AuthLayout (không menu).
    - Đã đăng nhập mà mở /login → quay lại trang trước (?returnUrl, chỉ nhận đường dẫn trong ứng dụng).
    - Lỗi hiện theo mã trạng thái / mã lỗi của API (AuthText.LoginError); sai email hay sai mật khẩu cùng một câu.
    - Không gửi trùng; 429 khóa nút theo Retry-After; mật khẩu không được giữ lại sau khi gửi.
    Logic nằm ở Helpers/LoginForm.cs (có test).
    B28: trang công khai — [AllowAnonymous] thay cho [Authorize] mặc định của Pages/_Imports.razor.
*@
@attribute [AllowAnonymous]
@layout AuthLayout
@implements IDisposable
@inject AuthSession Session
@inject IAuthApi AuthApi
@inject IRegistrationApi RegistrationApi
@inject RegistrationFlowState Flow
@inject PublicSettingsClient PublicSettings
@inject NavigationManager Nav
@inject TimeProvider Time

<PageTitle>Đăng nhập · SCApp</PageTitle>

@if (!ready)
{
    <div class="login-wait" role="status">
        <span class="spinner" aria-hidden="true"></span>
        <span>Đang kiểm tra phiên đăng nhập…</span>
    </div>
}
else
{
    <section class="login-card" aria-labelledby="login-title">
        <header class="login-head">
            <span class="login-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 2a5 5 0 0 1 5 5v3h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v3h6V7a3 3 0 0 0-3-3zm0 9.5a1.8 1.8 0 0 0-1 3.3V19h2v-2.2a1.8 1.8 0 0 0-1-3.3z" /></svg>
            </span>
            <h1 id="login-title">Đăng nhập</h1>
            <p class="login-lead">Đăng nhập để quản lý không gian làm việc và đánh giá hồ sơ tuyển dụng.</p>
        </header>

        @if (notice is not null && form.FormError is null)
        {
            <div class="login-notice @(noticeIsSuccess ? "is-success" : noticeIsError ? "is-danger" : "is-info")" role="status">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@(noticeIsSuccess ? CheckIcon : InfoIcon)" /></svg>
                <span>@notice</span>
            </div>
        }

        @if (form.FormError is { } error)
        {
            <div class="login-notice is-danger" role="alert" id="login-error" tabindex="-1" @ref="errorRef">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@AlertIcon" /></svg>
                <span>@error</span>
            </div>
        }

        @if (form.NeedsEmailVerification)
        {
            <div class="b53-login-verify" role="status">
                <strong>Email chưa xác minh</strong>
                <p>Sau khi mở liên kết xác minh, bạn sẽ có thể đăng nhập và sử dụng không gian làm việc riêng.</p>
                @if (resendNotice is { } msg) { <p class="b53-login-feedback" role="alert">@msg</p> }
                <button class="btn sc-btn-secondary b53-login-resend" type="button" disabled="@resending" @onclick="ResendFromLoginAsync">
                    @(resending ? "Đang gửi yêu cầu…" : "Gửi lại email xác minh")
                </button>
            </div>
        }

        <form class="login-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate aria-busy="@(form.Submitting ? "true" : "false")">
            <div class="field">
                <label class="field-label" for="login-email">Email</label>
                <input id="login-email" @ref="emailRef" class="sc-input field-input" type="email" name="email"
                       autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" maxlength="254"
                       placeholder="ten@congty.vn" readonly="@form.Submitting"
                       @bind="form.Email" @bind:event="oninput"
                       aria-invalid="@(form.EmailError is null ? "false" : "true")"
                       aria-describedby="@(form.EmailError is null ? null : "login-email-error")" />
                @if (form.EmailError is { } emailError)
                {
                    <p class="field-error" id="login-email-error">@emailError</p>
                }
            </div>

            <div class="field">
                <label class="field-label" for="login-password">Mật khẩu</label>
                <div class="password-wrap">
                    <input id="login-password" @ref="passwordRef" class="sc-input field-input" type="@(form.ShowPassword ? "text" : "password")" name="password"
                           autocomplete="current-password" autocapitalize="none" spellcheck="false" maxlength="128"
                           readonly="@form.Submitting"
                           @bind="form.Password" @bind:event="oninput"
                           aria-invalid="@(form.PasswordError is null ? "false" : "true")"
                           aria-describedby="@(form.PasswordError is null ? null : "login-password-error")" />
                    <button type="button" class="password-toggle" @onclick="TogglePassword"
                            aria-controls="login-password" aria-pressed="@(form.ShowPassword ? "true" : "false")"
                            aria-label="@(form.ShowPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" title="@(form.ShowPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@(form.ShowPassword ? EyeOffIcon : EyeIcon)" /></svg>
                    </button>
                </div>
                @if (form.PasswordError is { } passwordError)
                {
                    <p class="field-error" id="login-password-error">@passwordError</p>
                }
            </div>

            <button type="submit" @ref="submitRef" class="btn sc-btn-primary login-submit" disabled="@(!form.CanSubmit)">
                @if (form.Submitting)
                {
                    <span class="spinner on-dark" aria-hidden="true"></span>
                    <span>Đang đăng nhập…</span>
                }
                else if (form.IsRateLimited)
                {
                    <span>Thử lại sau @form.RetrySecondsLeft giây</span>
                }
                else
                {
                    <span>Đăng nhập</span>
                }
            </button>
        </form>

        <ExternalLoginButtons ReturnUrl="@NextUrl" />

        <div class="b53-login-footer">
            @if (registrationOpen)
            {
                <p>Chưa có tài khoản? <a href="/register">Tạo tài khoản miễn phí</a></p>
            }
            else
            {
                <p>Chưa có tài khoản? Liên hệ quản trị viên SCApp để được cấp quyền.</p>
            }
            <a class="b54-login-recovery" href="/forgot-password">Quên mật khẩu?</a>
        </div>

        <p class="login-security">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5z" /></svg>
            <span>Phiên đăng nhập được mã hóa và tự kết thúc khi bạn đóng tab trình duyệt.</span>
        </p>
    </section>
}

@code {
    private const string InfoIcon = "M12 2a10 10 0 1 1 0 20a10 10 0 0 1 0-20zm-1 8v7h2v-7zm0-3v2h2V7z";
    private const string CheckIcon = "M12 2a10 10 0 1 1 0 20a10 10 0 0 1 0-20zm-1.2 13.6 6.3-6.3-1.4-1.4-4.9 4.9-2.3-2.3-1.4 1.4z";
    private const string AlertIcon = "M12 2 1 21h22zm-1 7v6h2V9zm0 8v2h2v-2z";
    private const string EyeIcon = "M12 5c5 0 9 4.5 10 7-1 2.5-5 7-10 7S3 14.5 2 12c1-2.5 5-7 10-7zm0 3a4 4 0 1 0 0 8a4 4 0 0 0 0-8zm0 2a2 2 0 1 1 0 4a2 2 0 0 1 0-4z";
    private const string EyeOffIcon = "M3.3 2 2 3.3l3.2 3.2C3.6 7.8 2.5 9.9 2 12c1 2.5 5 7 10 7 1.9 0 3.6-.6 5.1-1.5L20.7 21l1.3-1.3zM12 5c5 0 9 4.5 10 7-.4 1-1.2 2.3-2.3 3.5L16 11.8V12a4 4 0 0 0-4-4h-.2L9.4 5.6C10.2 5.2 11.1 5 12 5zm-3.9 5.4 5.5 5.5A4 4 0 0 1 8.1 10.4z";

    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "expired")] public string? Expired { get; set; }
    [SupplyParameterFromQuery(Name = "signedOut")] public string? SignedOut { get; set; }
    [SupplyParameterFromQuery(Name = "reset")] public string? Reset { get; set; }
    [SupplyParameterFromQuery(Name = "external_error")] public string? ExternalError { get; set; }

    private bool registrationOpen;
    private bool resending;
    private string? resendNotice;
    private LoginForm form = default!;
    private bool ready;
    private string? notice;
    private bool noticeIsSuccess;
    private bool noticeIsError;
    private bool focusEmailOnReady = true;
    private ElementReference emailRef, passwordRef, submitRef, errorRef;
    private Timer? retryTimer;
    private readonly CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        form = new LoginForm(Time);
        await Session.EnsureRestoredAsync();
        if (Session.IsSignedIn)
        {
            Nav.NavigateTo(NextUrl, replace: true);
            return;
        }

        if (!string.IsNullOrWhiteSpace(ExternalError))
        {
            notice = AuthText.ExternalLoginError(ExternalError);
            noticeIsError = ExternalError != "cancelled";
        }
        else if (Reset == "1") (notice, noticeIsSuccess) = ("Đã đặt mật khẩu mới. Hãy đăng nhập bằng mật khẩu vừa tạo.", true);
        else if (Expired == "1" || Session.EndReason == AuthEndReason.Expired) notice = AuthText.SessionExpired;
        else if (SignedOut == "1") (notice, noticeIsSuccess) = (AuthText.SignedOut, true);
        ready = true; // Form đăng nhập không phải đợi CTA đăng ký.
        registrationOpen = await PublicSettings.IsRegistrationEnabledAsync();
    }

    private void TogglePassword() => form.ShowPassword = !form.ShowPassword;

    /// <summary>B29: tài khoản dùng mật khẩu tạm vào thẳng trang đổi mật khẩu (giữ trang muốn mở để quay lại sau).</summary>
    private string NextUrl => Session.MustChangePassword ? AuthText.ChangePasswordUrl(ReturnUrl) : AuthText.SafeReturnUrl(ReturnUrl);

    private async Task SubmitAsync()
    {
        if (!form.CanSubmit) return;
        notice = null;
        LoginResponse? response;
        try { response = await form.SubmitAsync(AuthApi, cts.Token); }
        catch (OperationCanceledException) { return; }   // rời trang khi đang gửi
        if (response is not null)
        {
            await Session.SignInAsync(response);
            Nav.NavigateTo(NextUrl, replace: true);
            return;
        }
        if (form.IsRateLimited) StartRetryTimer();
    }

    private async Task ResendFromLoginAsync()
    {
        if (resending || !form.NeedsEmailVerification) return;
        var email = SmartCv.Core.Auth.RegistrationRules.NormalizeResendEmail(form.Email);
        if (email is null) { resendNotice = "Email không hợp lệ."; return; }
        resending = true;
        resendNotice = null;
        try
        {
            var result = await RegistrationApi.ResendVerificationAsync(email, cts.Token);
            if (result.IsSuccess)
            {
                Flow.Remember(email);
                Flow.StartCooldown(TimeSpan.FromSeconds(60));
                Nav.NavigateTo("/verify-email/sent?email=" + Uri.EscapeDataString(Flow.MaskedEmail));
            }
            else if (result.StatusCode == 429)
                resendNotice = "Đã đạt giới hạn gửi email. Vui lòng thử lại sau.";
            else if (result.StatusCode == 404 && result.ErrorCode == "registration_disabled")
                resendNotice = "Gửi lại đang tạm tắt. Liên kết đã gửi trước đó vẫn có thể sử dụng.";
            else
                resendNotice = "Chưa thể gửi yêu cầu. Hãy kiểm tra hộp thư hoặc thử lại sau.";
        }
        catch (OperationCanceledException) { }
        finally { resending = false; }
    }

    private void StartRetryTimer()
    {
        retryTimer?.Dispose();
        retryTimer = new Timer(_ => InvokeAsync(() =>
        {
            form.ClearExpiredRateLimit();
            if (!form.IsRateLimited) { retryTimer?.Dispose(); retryTimer = null; }
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ready) return;
        try
        {
            if (focusEmailOnReady)
            {
                focusEmailOnReady = false;
                await emailRef.FocusAsync();
                return;
            }
            var target = form.FocusTarget;
            if (target == LoginField.None || form.Submitting) return;
            form.ClearFocusTarget();
            await (target switch
            {
                LoginField.Email => emailRef.FocusAsync(),
                LoginField.Password => passwordRef.FocusAsync(),
                _ => form.FormError is null ? submitRef.FocusAsync() : errorRef.FocusAsync()
            });
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // Mất kết nối giữa chừng: không cần đặt con trỏ.
        }
    }

    public void Dispose()
    {
        retryTimer?.Dispose();
        cts.Cancel();
        cts.Dispose();
    }
}

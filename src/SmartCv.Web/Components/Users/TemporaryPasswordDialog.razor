@*
    B29: mật khẩu tạm vừa tạo / đặt lại — hiện MỘT lần. Có nút sao chép; đóng hộp thoại là xóa khỏi bộ nhớ (UsersWorkspace).
    Không ghi log, không lưu vào trình duyệt. Người dùng phải đổi mật khẩu ở lần đăng nhập đầu tiên (A30).
*@
@implements IDisposable
@inject IJSRuntime JS

<ModalShell Id="user-credential" Eyebrow="@Model.CredentialTitle" Title="@($"Mật khẩu tạm của {Model.Target?.FullName}")"
            FocusId="user-credential-copy" ReturnFocusId="@ReturnFocusId" FallbackFocusId="users-title" OnClose="OnClose">
    <ChildContent>
        @if (Model.Target is { } u && Model.TemporaryPassword is { } password)
        {
            <p class="tp-for">Đăng nhập bằng <strong>@u.Email</strong></p>
            <div class="tp-box">
                <input id="user-credential-value" class="tp-value" type="text" value="@password" readonly aria-label="Mật khẩu tạm" spellcheck="false" autocomplete="off" />
                <button id="user-credential-copy" type="button" class="btn sc-btn-primary tp-copy" @onclick="CopyAsync">
                    @(copied ? "Đã sao chép" : "Sao chép")
                </button>
            </div>
            <p class="tp-status" role="status">@status</p>
            <ul class="tp-notes">
                <li>Mật khẩu này <strong>chỉ hiện một lần</strong>. Đóng hộp thoại là không xem lại được.</li>
                <li>Gửi riêng cho người dùng (trực tiếp hoặc tin nhắn cá nhân) — không gửi vào nhóm chat chung.</li>
                <li>Ở lần đăng nhập đầu tiên, người dùng phải đặt mật khẩu riêng.</li>
            </ul>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn sc-btn-secondary" @onclick="OnClose">Tôi đã lưu mật khẩu, đóng</button>
    </Footer>
</ModalShell>

@code {
    [Parameter, EditorRequired] public UsersWorkspace Model { get; set; } = default!;
    [Parameter] public string? ReturnFocusId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool copied;
    private string? status;

    private async Task CopyAsync()
    {
        if (Model.TemporaryPassword is not { } password) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", password);
            (copied, status) = (true, "Đã sao chép mật khẩu tạm vào bộ nhớ tạm.");
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // Trình duyệt chặn clipboard (không phải HTTPS / không cho phép): người dùng tự chọn và sao chép trong ô.
            (copied, status) = (false, "Trình duyệt không cho sao chép tự động. Hãy chọn mật khẩu trong ô rồi sao chép thủ công.");
        }
    }

    public void Dispose() => (copied, status) = (false, null);
}

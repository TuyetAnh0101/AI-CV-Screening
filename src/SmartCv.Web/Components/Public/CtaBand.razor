<section class="band" aria-labelledby="cta-heading">
    <div class="lp-wrap cta-box" data-reveal>
        <div>
            <h2 id="cta-heading">Bắt đầu quy trình tuyển dụng có tổ chức hơn cùng SCApp</h2>
            <p>Chỉ cần một vị trí và những hồ sơ bạn được phép xử lý.</p>
        </div>
        <div class="actions">
            <a class="lp-btn cta-button" href="@Cta.Href">@Cta.Text <LandingIcon Name="arrow-right" Size="17" /></a>
            @if (Cta.Kind == PublicCtaKind.SignIn)
            {
                <small>Đăng ký công khai hiện chưa mở.</small>
            }
        </div>
    </div>
</section>

@code { [Parameter, EditorRequired] public PublicCta Cta { get; set; } = PublicCta.SignIn; }

<section id="how-it-works" class="section" aria-labelledby="how-heading">
    <div class="container">
        <div class="heading"><p class="eyebrow">QUY TRÌNH</p><h2 id="how-heading">5 bước từ vị trí tuyển dụng đến quyết định</h2><p>SCApp tổ chức luồng làm việc theo thứ tự dễ hiểu, không thay thế trách nhiệm đánh giá của nhân sự.</p></div>
        <ol class="steps">
            @foreach (var step in Steps)
            {
                <li><span class="number">@step.Number</span><h3>@step.Title</h3><p>@step.Description</p></li>
            }
        </ol>
        <p class="note">Khi đăng ký công khai chưa mở, người dùng cần tài khoản được quản trị viên cấp để bắt đầu.</p>
    </div>
</section>
@code {
    private sealed record Step(string Number, string Title, string Description);
    private static readonly Step[] Steps = [
        new("01", "Đăng ký", "Tạo tài khoản khi được mở hoặc đăng nhập tài khoản đã cấp."),
        new("02", "Tạo vị trí", "Khai báo yêu cầu và tiêu chí đánh giá."),
        new("03", "Tải CV", "Nộp hồ sơ được phép xử lý, chọn vị trí phù hợp."),
        new("04", "AI phân tích", "Hệ thống hỗ trợ đối chiếu và tổng hợp kết quả."),
        new("05", "HR quyết định", "Xem giải thích, kiểm tra và cập nhật trạng thái.")
    ];
}
<section id="how-it-works" class="lp-section" aria-labelledby="how-heading">
    <div class="lp-wrap">
        <div class="lp-head" data-reveal>
            <p class="lp-eyebrow">Cách hoạt động</p>
            <h2 id="how-heading">6 bước từ vị trí tuyển dụng đến quyết định</h2>
            <p class="lp-lead">Tải CV lên chưa phải là chấm điểm: bạn kiểm tra chữ đã đọc, chọn vị trí rồi mới bắt đầu lượt phân tích.</p>
        </div>

        <ol class="steps">
            @for (var index = 0; index < Steps.Length; index++)
            {
                var step = Steps[index];
                <li data-lp-step>
                    <span class="marker">
                        <LandingIcon Name="@step.Icon" Size="19" />
                    </span>
                    <span class="number">Bước @(index + 1)</span>
                    <h3>@step.Title</h3>
                    <p>@step.Description</p>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private sealed record Step(string Icon, string Title, string Description);

    // Thứ tự theo trang Tải lên & Phân tích: nguồn và đồng ý → tải → kiểm tra chữ → chọn công việc → phân tích.
    private static readonly Step[] Steps =
    [
        new("briefcase", "Tạo vị trí", "Khai báo yêu cầu, kỹ năng và tiêu chí đánh giá."),
        new("upload", "Tải hồ sơ", "Chọn nguồn CV, xác nhận đồng ý rồi tải tệp."),
        new("text", "Kiểm tra chữ", "Xem tình trạng trích xuất và cảnh báo nếu có."),
        new("spark", "Chạy đánh giá", "Chọn vị trí và chủ động bắt đầu lượt phân tích."),
        new("ranking", "Xem kết quả", "Đọc điểm, giải thích và thứ hạng."),
        new("user", "Quyết định", "Người tuyển dụng xem xét và cập nhật giai đoạn.")
    ];
}

            ["Nhận tệp PDF, JPG và PNG", "Nhận biết hồ sơ đã có sẵn", "Xem lại chữ đã đọc trước khi chấm"],
            "Danh sách tệp vừa tải",
            [
                new("cv-mau-01.pdf", "Đã đọc chữ", "ok"),
                new("cv-mau-02.jpg", "Nên kiểm tra OCR", "warn"),
                new("cv-mau-03.pdf", "Đã có sẵn", "info")
            ]),
        new("ai", "Phân tích AI", "spark",
            "Đối chiếu từng hồ sơ với yêu cầu",

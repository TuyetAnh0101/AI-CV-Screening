<section id="showcase" class="lp-section showcase" aria-labelledby="showcase-heading">
    <div class="lp-wrap">
        <div class="lp-head is-center" data-reveal>
            <p class="lp-eyebrow">Xem trước trải nghiệm</p>
            <h2 id="showcase-heading">Mỗi chặng công việc có một góc nhìn riêng</h2>
            <p class="lp-lead">Chọn từng mục để xem SCApp hỗ trợ gì. Các hình bên dưới là minh họa bằng dữ liệu mẫu.</p>
        </div>

        <div class="tabs" role="tablist" aria-label="Các khu vực sản phẩm">
            @for (var index = 0; index < Tabs.Length; index++)
            {
                var i = index;
                var tab = Tabs[i];
                <button type="button" role="tab" id="showcase-tab-@tab.Key" class="tab"
                        aria-selected="@(selected == i ? "true" : "false")"
                        aria-controls="showcase-panel-@tab.Key"
                        tabindex="@(selected == i ? "0" : "-1")"
                        @ref="buttons[i]"
                        @onclick="() => selected = i"
                        @onkeydown="OnKeyAsync">
                    <LandingIcon Name="@tab.Icon" Size="17" />
                    <span>@tab.Label</span>
                </button>
            }
        </div>

        @for (var index = 0; index < Tabs.Length; index++)
        {
            var i = index;
            var tab = Tabs[i];
            <div class="panel" role="tabpanel" id="showcase-panel-@tab.Key"
                 aria-labelledby="showcase-tab-@tab.Key" tabindex="0" hidden="@(selected != i)">
                <div class="panel-copy">
                    <h3>@tab.Title</h3>
                    <p>@tab.Description</p>
                    <ul>
                        @foreach (var point in tab.Points)
                        {
                            <li><LandingIcon Name="check" Size="16" /> <span>@point</span></li>
                        }
                    </ul>
                </div>
                <div class="screen" aria-hidden="true">
                    <div class="screen-head"><strong>@tab.ScreenTitle</strong><span>Dữ liệu mẫu</span></div>
                    @foreach (var line in tab.Lines)
                    {
                        <div class="line">
                            <span class="line-mark"></span>
                            <span class="line-main">@line.Main</span>
                            <span class="line-tag @line.Tone">@line.Tag</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private sealed record Line(string Main, string Tag, string Tone);
    private sealed record Tab(string Key, string Label, string Icon, string Title, string Description,
        string[] Points, string ScreenTitle, Line[] Lines);


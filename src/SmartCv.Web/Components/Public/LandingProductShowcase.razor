            ["Xuất Excel hoặc PDF", "Có lựa chọn ẩn danh ứng viên", "Hoạt động xuất được ghi nhật ký"],
            "Báo cáo tuyển dụng",
            [
                new("Tổng hợp theo vị trí", "Excel", "ok"),
                new("Bản in gửi người phụ trách", "PDF", "info"),
                new("Danh sách ứng viên", "Ẩn danh", "warn")

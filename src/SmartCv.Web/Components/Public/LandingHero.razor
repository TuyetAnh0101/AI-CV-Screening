<section class="hero" aria-labelledby="landing-title">
    <div class="lp-wrap hero-grid">
        <div class="hero-copy">
            <p class="hero-badge">
                <LandingIcon Name="spark" Size="15" />
                Sàng lọc CV có AI hỗ trợ
            </p>
            <h1 id="landing-title">Sàng lọc thông minh. <span>Tuyển dụng <em>có căn cứ.</em></span></h1>
            <p class="hero-lead">
                SCApp gom việc quản lý hồ sơ, đối chiếu yêu cầu công việc, phân tích bằng từ khóa và AI
                cùng xếp hạng ứng viên vào một quy trình, để bạn quyết định dựa trên thông tin rõ ràng hơn.
            </p>
            <div class="hero-actions">
                <a class="lp-btn lp-btn-primary" href="@Cta.Href">
                    @Cta.Text <LandingIcon Name="arrow-right" Size="17" />
                </a>
                <a class="lp-btn lp-btn-ghost" href="/#how-it-works">Xem cách hoạt động</a>
            </div>
            @if (Cta.Kind == PublicCtaKind.SignIn)
            {
                <p class="hero-note">Đăng ký công khai hiện chưa mở — hãy dùng tài khoản đã được cấp.</p>
            }
            <p class="hero-promise">
                <LandingIcon Name="user" Size="17" />
                AI đề xuất và giải thích. Người tuyển dụng đưa ra quyết định cuối cùng.
            </p>
        </div>

        <figure class="hero-visual">
            <div class="window" role="img"
                 aria-label="Hình minh họa giao diện: bảng xếp hạng ba hồ sơ mẫu kèm mức phù hợp và kỹ năng đối chiếu">
                <div class="window-bar">
                    <strong>Xếp hạng ứng viên</strong>
                    <span>Vị trí mẫu: Lập trình viên .NET</span>
                </div>
                <div class="window-body">
                    @foreach (var row in Rows)
                    {
                        <div class="rank @(row.Order == 1 ? "is-top" : "")">
                            <span class="rank-order">@row.Order</span>
                            <span class="rank-name">
                                <strong>@row.Name</strong>
                                <small>@row.Note</small>
                            </span>
                            <span class="rank-score">@row.Score</span>
                            <span class="rank-fit @row.Tone">@row.Fit</span>
                        </div>
                    }
                    <div class="skills">
                        <span class="skills-title">Hồ sơ mẫu A</span>
                        <span class="chip">✓ C#</span>
                        <span class="chip">✓ SQL Server</span>
                        <span class="chip warn">! Chưa thấy: Docker</span>
                    </div>
                </div>
            </div>
            <figcaption>Giao diện minh họa bằng dữ liệu mẫu, không phải ảnh chụp hệ thống.</figcaption>
        </figure>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public PublicCta Cta { get; set; } = PublicCta.SignIn;

    // Dữ liệu hoàn toàn giả lập, chỉ để minh họa bố cục.
    private sealed record Row(int Order, string Name, string Note, int Score, string Fit, string Tone);
    private static readonly Row[] Rows =
    [
        new(1, "Hồ sơ mẫu A", "Đủ kỹ năng bắt buộc", 88, "Rất phù hợp", "fit-high"),
        new(2, "Hồ sơ mẫu B", "Cần xem thêm kinh nghiệm", 74, "Phù hợp", "fit-mid"),
        new(3, "Hồ sơ mẫu C", "Thiếu một kỹ năng bắt buộc", 61, "Tiềm năng", "fit-low")
    ];
}

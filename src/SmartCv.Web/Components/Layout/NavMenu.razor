@*
    Menu bên trái (Figma "SC v2"): khối logo "SCApp", nhãn nhóm chữ nhỏ in hoa, mục đang chọn nền trắng 10% + vạch sáng.
    B28: mục menu theo vai trò (Helpers/AppNavigation.cs): mục AdminOnly chỉ Admin thấy, nhóm không còn mục nào thì ẩn cả nhóm.
    Vai trò lấy từ trạng thái đăng nhập cascade (ApiAuthenticationStateProvider) — đổi vai trò / đăng xuất là menu vẽ lại ngay.
    Màn hình hẹp: thêm khối tài khoản (họ tên, vai trò, Đăng xuất) cuối danh sách vì thanh trên cùng chỉ còn chỗ cho ảnh đại diện.
    Kiểu ở NavMenu.razor.css.
*@
@inject AuthNavigator Navigator

<div class="brand">
    <a href="@AppNavigation.HomeFor(user)" class="brand-link" aria-label="SCApp — Bảng điều khiển">
        <img class="brand-logo" src="images/brand/scapp-logo.png" width="68" height="54" alt="SCApp" />
        <span class="brand-name" aria-hidden="true">SC<span>App</span></span>
    </a>
    <button type="button" class="menu-toggle" @onclick="Toggle" aria-label="@(collapsed ? "Mở menu" : "Đóng menu")"
            aria-expanded="@(!collapsed ? "true" : "false")" aria-controls="main-navigation">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@(collapsed ? MenuIcon : CloseIcon)" /></svg>
    </button>
</div>

<div class="rx-role-tools" data-rx-nav-toolbar>
    <span class="rx-role-caption">@RoleBasedNavigation.PersonaLabel(user)</span>
    <label class="rx-role-search"><span aria-hidden="true">⌕</span>
        <input type="search" data-rx-nav-search aria-label="Tìm trong menu" placeholder="Tìm mục điều hướng…" maxlength="80" autocomplete="off" />
        <kbd>Ctrl K</kbd>
    </label>
</div>
<nav id="main-navigation" data-rx-nav-target aria-label="Điều hướng chính" class="nav-list @(collapsed ? "collapsed" : null)">
    @foreach (var group in groups)
    {
        <div class="nav-group" role="presentation">@group.Title</div>
        @foreach (var item in group.Items)
        {
            <NavLink class="nav-item" href="@item.Href" Match="@item.Match" @onclick="Collapse">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="@item.Icon" /></svg>
                <span>@item.Text</span>
            </NavLink>
        }
    }

    <div class="rx-nav-empty" data-rx-nav-empty hidden role="status">Không có chức năng khớp từ khóa.</div>

    @if (AccessRules.FullName(user) is { } name)
    {
        <div class="nav-account" aria-label="Tài khoản đang đăng nhập" role="group">
            <span class="nav-account-avatar" aria-hidden="true">@AuthText.Initials(name)</span>
            <span class="nav-account-who">
                <span class="nav-account-name">@name</span>
                <span class="nav-account-role">@AccessRules.RoleName(user)</span>
            </span>
            <a class="nav-account-key" href="@AuthText.ChangePasswordPath" @onclick="Collapse" aria-label="Đổi mật khẩu" title="Đổi mật khẩu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 14a5 5 0 1 1 4.6-7H22v4h-2v3h-3v-3h-5.4A5 5 0 0 1 7 14zm0-3a2 2 0 1 0 0-4a2 2 0 0 0 0 4z" /></svg>
            </a>
            <button type="button" class="nav-account-logout" @onclick="Navigator.SignOutAsync" disabled="@Navigator.IsLeaving">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 3h9a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-9v-2h9V5h-9zm-.6 4.4L11 9l-2 2h8v2H9l2 2-1.6 1.6L4.8 12z" /></svg>
                <span>Đăng xuất</span>
            </button>
        </div>
    }
</nav>

@code {
    private const string MenuIcon = "M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z";
    private const string CloseIcon = "m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6l5.6-5.6L5 6.4z";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool collapsed = true;   // chỉ có tác dụng trên màn hình hẹp
    private System.Security.Claims.ClaimsPrincipal user = AccessRules.Nobody;
    private IReadOnlyList<NavGroup> groups = [];

    protected override async Task OnParametersSetAsync()
    {
        user = await AccessRules.ResolveAsync(AuthState);
        groups = AppNavigation.For(user);
    }

    private void Toggle() => collapsed = !collapsed;
    private void Collapse() => collapsed = true;
}

@* Menu bên trái theo Figma: logo "SCApp", tiêu đề nhóm chữ trắng đậm, mục đang chọn nền #0F766E. *@

<div class="brand">
    <a href="" class="brand-link">
        <span class="brand-logo" aria-hidden="true">SC</span>
        <span class="brand-name">SC<span>App</span></span>
    </a>
    <button type="button" class="menu-toggle" @onclick="Toggle" aria-label="Mở/đóng menu">☰</button>
</div>

<nav class="nav-list @(collapsed ? "collapsed" : null)">
    @foreach (var group in groups)
    {
        <div class="nav-group">@group.Title</div>
        @foreach (var item in group.Items)
        {
            <NavLink class="nav-item" href="@item.Href" Match="@item.Match" @onclick="Collapse">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="@item.Icon" /></svg>
                <span>@item.Text</span>
            </NavLink>
        }
    }
</nav>

@code {
    private bool collapsed = true;   // chỉ có tác dụng trên màn hình hẹp

    private void Toggle() => collapsed = !collapsed;
    private void Collapse() => collapsed = true;

    private sealed record MenuItem(string Text, string Href, string Icon, NavLinkMatch Match = NavLinkMatch.Prefix);
    private sealed record MenuGroup(string Title, MenuItem[] Items);

    // Giai đoạn 2 (M1–M7): thêm nhóm/mục mới vào đây
    private readonly MenuGroup[] groups =
    [
        new("Tổng quan",
        [
            new("Bảng điều khiển", "", "M3 11 12 3l9 8v10h-6v-6H9v6H3z", NavLinkMatch.All),
        ]),
        new("Tuyển dụng",
        [
            new("Tải hồ sơ lên", "upload", "M12 3 6 9h4v6h4V9h4zM4 17h16v4H4z"),
            new("Kết quả", "results", "M4 20V10h3v10zm6.5 0V4h3v16zM17 20v-7h3v7z"),
        ]),
        new("Đánh giá AI",
        [
            new("System prompt", "prompts", "M4 4h16v12H8l-4 4zm4 5h8V7H8zm0 4h5v-2H8z"),
        ]),
    ];
}

@* Menu bên trái (Figma "SC v2"): khối logo "SCApp", nhãn nhóm chữ nhỏ in hoa, mục đang chọn nền trắng 10% + vạch sáng. Kiểu ở NavMenu.razor.css. *@

<div class="brand">
    <a href="" class="brand-link" aria-label="SCApp — Trang chủ">
        <img class="brand-logo" src="images/brand/scapp-logo.png" width="68" height="54" alt="SCApp" />
        <span class="brand-name" aria-hidden="true">SC<span>App</span></span>
    </a>
    <button type="button" class="menu-toggle" @onclick="Toggle" aria-label="Mở/đóng menu"
            aria-expanded="@(!collapsed ? "true" : "false")" aria-controls="main-navigation">☰</button>
</div>

<nav id="main-navigation" aria-label="Điều hướng chính" class="nav-list @(collapsed ? "collapsed" : null)">
    @foreach (var group in groups)
    {
        <div class="nav-group">@group.Title</div>
        @foreach (var item in group.Items)
        {
            <NavLink class="nav-item" href="@item.Href" Match="@item.Match" @onclick="Collapse">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="@item.Icon" /></svg>
                <span>@item.Text</span>
            </NavLink>
        }
    }
</nav>

@code {
    private bool collapsed = true;   // chỉ có tác dụng trên màn hình hẹp

    private void Toggle() => collapsed = !collapsed;
    private void Collapse() => collapsed = true;

    private sealed record MenuItem(string Text, string Href, string Icon, NavLinkMatch Match = NavLinkMatch.Prefix);
    private sealed record MenuGroup(string Title, MenuItem[] Items);

    // Giai đoạn 2 (M1–M7): thêm nhóm/mục mới vào đây
    private readonly MenuGroup[] groups =
    [
        new("Tổng quan",
        [
            new("Bảng điều khiển", "", "M3 11 12 3l9 8v10h-6v-6H9v6H3z", NavLinkMatch.All),
        ]),
        new("Tuyển dụng",
        [
            new("Tải hồ sơ lên", "upload", "M12 3 6 9h4v6h4V9h4zM4 17h16v4H4z"),
            // B24: một mục duy nhất cho người và file CV (thay "Kho CV"); /candidates/{id} cũng sáng mục này
            new("Ứng viên", "candidates", "M9 11a4 4 0 1 1 0-8a4 4 0 0 1 0 8zm-7 9a7 7 0 0 1 14 0v1H2zm15-9a3 3 0 1 0 0-6v6zm1 2a5 5 0 0 1 4 5v3h-3v-1a8 8 0 0 0-1-4z"),
            new("Kết quả", "results", "M4 20V10h3v10zm6.5 0V4h3v16zM17 20v-7h3v7z"),
        ]),
        new("Đánh giá AI",
        [
            new("System prompt", "prompts", "M4 4h16v12H8l-4 4zm4 5h8V7H8zm0 4h5v-2H8z"),
        ]),
        new("Quản lý",
        [
            new("Vị trí tuyển dụng", "jobs", "M3 7h18v14H3zm5-4h8v4h-2V5h-4v2H8zm-5 9h18v2H3z"),
            // B26: lịch sử lượt chấm (/runs và /runs/{id} cùng sáng mục này)
            new("Lịch sử lượt chấm", "runs", "M12 3a9 9 0 1 1 0 18a9 9 0 1 1 0-18zM12 5a7 7 0 1 0 0 14a7 7 0 1 0 0-14zM11 7h2v4.6l3.4 3.4-1.4 1.4L11 12.4z"),
        ]),
    ];
}

@*
    B27: người đang đăng nhập (chữ viết tắt, họ tên, vai trò) và nút Đăng xuất trên thanh trên cùng.
    B28: họ tên / vai trò đọc từ trạng thái đăng nhập cascade (cùng nguồn với menu và AuthorizeRouteView) nên đổi cùng lúc.
    Đăng xuất (AuthNavigator): xóa phiên trong bộ nhớ và sessionStorage, rồi tải lại /login — circuit cũ bị bỏ nên không còn
    dữ liệu cũ nào trên giao diện (Back của trình duyệt cũng chỉ về được trang đăng nhập).
*@
@using SmartCv.Core.Auth
@inject AuthNavigator Navigator

@if (AccessRules.FullName(user) is { } name)
{
    var role = AccessRules.RoleName(user);
    <div class="user-menu">
        <span class="avatar" aria-hidden="true">@AuthText.Initials(name)</span>
        <span class="who">
            <span class="name" title="@user.FindFirst(SmartCvClaims.Email)?.Value">@name</span>
            <span class="role">@role</span>
        </span>
        <span class="visually-hidden">Đang đăng nhập: @name, @role.</span>
        <button type="button" class="logout" @onclick="Navigator.SignOutAsync" disabled="@Navigator.IsLeaving" aria-label="Đăng xuất" title="Đăng xuất khỏi SCApp">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 3h9a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-9v-2h9V5h-9zm-.6 4.4L11 9l-2 2h8v2H9l2 2-1.6 1.6L4.8 12z" /></svg>
            <span>Đăng xuất</span>
        </button>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private System.Security.Claims.ClaimsPrincipal user = AccessRules.Nobody;

    protected override async Task OnParametersSetAsync() => user = await AccessRules.ResolveAsync(AuthState);
}

@*
    FIX-B56-UI: hồ sơ là điểm vào trang /account.
    Không truy xuất ảnh Google bên ngoài, vì MeDto chưa có avatar URL đáng tin cậy.
    Giữ avatar initials; trang /account đã chứa chức năng bảo mật/đổi mật khẩu.
    Đăng xuất giữ nguyên AuthNavigator.SignOutAsync (không tự thao tác token).
*@
@using SmartCv.Core.Auth
@inject AuthNavigator Navigator

@if (AccessRules.FullName(user) is { } name)
{
    var role = AccessRules.RoleName(user);
    <div class="user-menu">
        <a class="profile-trigger" href="/account"
           aria-label="Mở tài khoản của @name, @role" title="Mở thông tin tài khoản">
            <span class="avatar" aria-hidden="true">@AuthText.Initials(name)</span>
            <span class="who">
                <span class="name">@name</span>
                <span class="role">@role</span>
            </span>
            <svg class="profile-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="m9 18 6-6-6-6" />
            </svg>
        </a>
        <button type="button" class="logout" @onclick="Navigator.SignOutAsync"
                disabled="@Navigator.IsLeaving" aria-label="Đăng xuất" title="Đăng xuất khỏi SCApp">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M10 3h9a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-9v-2h9V5h-9zm-.6 4.4L11 9l-2 2h8v2H9l2 2-1.6 1.6L4.8 12z" />
            </svg>
            <span>Đăng xuất</span>
        </button>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private System.Security.Claims.ClaimsPrincipal user = AccessRules.Nobody;
    protected override async Task OnParametersSetAsync() => user = await AccessRules.ResolveAsync(AuthState);
}

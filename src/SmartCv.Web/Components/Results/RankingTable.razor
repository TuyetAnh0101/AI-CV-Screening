@*
    B7: bảng xếp hạng ứng viên của MỘT job trong MỘT lượt chấm (dữ liệu từ GET /api/runs/{id}/ranking, A13).
    Tìm kiếm không dấu, lọc nhanh và sắp xếp chạy ngay trên trình duyệt, không gọi lại API.
    CV chưa có điểm luôn nằm cuối, điểm hiện "—" (không gán 0).
    B8: nhãn 4 mức (FitBadge), thanh điểm keyword/điểm cuối/ngưỡng Đạt (ScoreBar), cột kỹ năng bắt buộc đủ/thiếu.
    B9: liên kết chi tiết giữ nguyên lượt chấm và vị trí. Chưa có dải tiến độ B10.
*@
@using SmartCv.Core.Constants
@inject ApplicationApiClient ApplicationApi
@inject HrActorState ActorState
@implements IDisposable

<section class="ranking" aria-labelledby="ranking-title" aria-busy="@((Loading || busy) ? "true" : "false")">
    <div class="ranking-head">
        <div>
            <h2 id="ranking-title" tabindex="-1">Bảng xếp hạng ứng viên</h2>
            <p>Mặc định sắp theo điểm cuối giảm dần · CV chưa có điểm nằm cuối bảng</p>
        </div>
        <ul class="legend" aria-label="Chú giải thanh điểm">
            <li><span class="lg lg-kw" aria-hidden="true"></span>Điểm keyword</li>
            <li><span class="lg lg-final" aria-hidden="true"></span>Điểm cuối (màu theo mức)</li>
            <li><span class="lg lg-pass" aria-hidden="true"></span>Ngưỡng Đạt @RankingView.Score(PassThreshold)</li>
        </ul>
    </div>

    <div class="decision-intro"><span class="decision-mark" aria-hidden="true">✓</span><span><strong>Không bỏ lỡ ứng viên phù hợp</strong><br />AI gợi ý mức phù hợp. HR quyết định giai đoạn hồ sơ.</span></div>

    @if (IssueCount > 0)
    {
        <div class="data-issue" role="status">
            <span class="data-issue-icon" aria-hidden="true">!</span>
            <span>@IssueCount CV có nhãn mức từ API không khớp quy tắc điểm hoặc không hợp lệ. Giao diện giữ nguyên nhãn của API và đánh dấu <strong>!</strong> — rê chuột vào nhãn để xem chi tiết, cần kiểm tra dữ liệu chấm.</span>
        </div>
    }

    <div class="ranking-tools">
        <div class="search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input type="search" placeholder="Tìm tên ứng viên, tên file..." aria-label="Tìm ứng viên theo tên hoặc tên file"
                   @bind="search" @bind:event="oninput" @bind:after="ClearSelection" autocomplete="off" disabled="@(busy || pending is not null)" />
            @if (!string.IsNullOrEmpty(search))
            {
                <button type="button" class="search-clear" @onclick="ClearSearch" aria-label="Xóa từ khóa tìm kiếm">×</button>
            }
        </div>

        <div class="quick" role="group" aria-label="Lọc nhanh">
            @foreach (var (value, label) in RankingView.Filters)
            {
                var on = filter == value;
                <button type="button" class="quick-btn @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")"
                        disabled="@(busy || pending is not null)" @onclick="() => SetFitFilter(value)">
                    @label <span class="count">@RankingView.Count(StageFilteredItems, search, value)</span>
                </button>
            }
        </div>

        <label class="sort">
            <span class="visually-hidden">Sắp xếp</span>
            <select class="form-select" @bind="sort" aria-label="Sắp xếp bảng xếp hạng" disabled="@(busy || pending is not null)">
                @foreach (var (value, label) in RankingView.Sorts)
                {
                    <option value="@value">@label</option>
                }
            </select>
        </label>
    </div>

    <div class="stage-filters" role="group" aria-label="Lọc giai đoạn hồ sơ">
        <span class="filter-label">Giai đoạn</span>
        <button type="button" class="stage-filter @(stageFilter is null ? "on" : null)" aria-pressed="@(stageFilter is null ? "true" : "false")" disabled="@(busy || pending is not null)" @onclick="() => SetStageFilter(null)">Tất cả <span>@StageCount(null)</span></button>
        @foreach (var stage in ApplicationStages.All)
        {
            <button type="button" class="stage-filter @StageText.Css(stage) @(stageFilter == stage ? "on" : null)" aria-pressed="@(stageFilter == stage ? "true" : "false")" disabled="@(busy || pending is not null)" @onclick="() => SetStageFilter(stage)">
                <i class="stage-dot" aria-hidden="true"></i>@StageText.Name(stage) <span>@StageCount(stage)</span>
            </button>
        }
    </div>
    @if (message is not null)
    {
        <div class="stage-notice @(messageIsError ? "is-error" : "is-success")" role="@(messageIsError ? "alert" : "status")">
            <span>@message</span><button type="button" class="notice-close" aria-label="Đóng thông báo quyết định" @onclick="() => message = null">×</button>
        </div>
    }
    @if (needsSync)
    {
        <div class="stage-notice is-error" role="alert">Chưa đồng bộ được dữ liệu mới. Hãy tải lại trước khi quyết định tiếp.
            <button type="button" class="btn sc-btn-secondary" disabled="@busy" @onclick="RetrySyncAsync">Tải lại giai đoạn</button>
        </div>
    }
    @if (selected.Count > 0)
    {
        <div class="bulk-bar" role="group" aria-label="Thao tác hàng loạt">
            <span class="bulk-count">Đã chọn <strong>@selected.Count</strong> hồ sơ <small>· tối đa 200</small></span>
            <button id="bulk-shortlist" type="button" class="btn sc-btn-primary" disabled="@TableLocked" @onclick="() => RequestBulkAsync(ApplicationStages.Shortlisted)">Qua vòng CV</button>
            <button id="bulk-hold" type="button" class="btn sc-btn-secondary" disabled="@TableLocked" @onclick="() => RequestBulkAsync(ApplicationStages.OnHold)">Dự phòng</button>
            <button id="bulk-reject" type="button" class="btn bulk-reject" disabled="@TableLocked" @onclick="() => RequestBulkAsync(ApplicationStages.Rejected)">Loại…</button>
            <button type="button" class="btn bulk-clear" disabled="@(busy || pending is not null)" @onclick="ClearSelection">Bỏ chọn</button>
        </div>
    }

    @if (Items.Count == 0)
    {
        <div class="table-empty" role="status">
            <p class="empty-title">Vị trí này chưa có CV nào trong lượt chấm</p>
            <p>Hãy chọn vị trí khác ở ô <strong>Vị trí tuyển dụng</strong>, hoặc tải thêm CV ở trang <a href="upload">Tải hồ sơ lên</a>.</p>
        </div>
    }
    else
    {
        var rows = VisibleRows;

        <label class="select-visible"><input type="checkbox" checked="@AllVisibleSelected" aria-label="Chọn mọi hồ sơ đang hiển thị" aria-checked="@(SomeVisibleSelected ? "mixed" : AllVisibleSelected ? "true" : "false")" disabled="@(TableLocked || rows.Count == 0 || rows.Count > 200)" @onchange="ToggleAll" />
            Chọn mọi hồ sơ đang hiển thị <small>(@rows.Count)</small>
            @if (rows.Count > 200) { <small>Hãy lọc còn tối đa 200 hồ sơ để chọn tất cả.</small> }
        </label>

        <div class="table-wrap">
            <table class="rank-table">
                <caption class="visually-hidden">Bảng xếp hạng @Items.Count CV, @RankingView.Sorts.First(s => s.Value == sort).Label</caption>
                <thead>
                    <tr>
                        <th scope="col" class="c-select"><span class="visually-hidden">Chọn hồ sơ</span></th>
                        <th scope="col" class="c-rank">Hạng</th>
                        <th scope="col">Ứng viên</th>
                        <th scope="col" class="c-num">Bắt buộc</th>
                        <th scope="col" class="c-num">Kinh nghiệm</th>
                        <th scope="col" class="c-bar">Điểm keyword / AI</th>
                        <th scope="col" class="c-num">Điểm cuối</th>
                        <th scope="col">Mức phù hợp</th>
                        <th scope="col" class="c-stage">Giai đoạn</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        var failed = IsFailed(r);
                        var scored = !failed && RankingView.IsScored(r);
                        var keywordOnly = r.ScoreSource == ScoreSources.KeywordOnly;
                        var must = MustHaveDisplay.From(r.MatchedMustHave, r.TotalMustHave, scored);
                        <tr class="@RowClass(r, scored) @(selected.Contains(r.ApplicationId) ? "is-selected" : null)" @key="r.EvaluationId">
                            <td class="c-select"><input type="checkbox" @key="(r.ApplicationId, selectVersion, selected.Contains(r.ApplicationId))" aria-label="@($"Chọn hồ sơ {r.ApplicationId}: {r.CandidateName ?? r.FileName}")" checked="@selected.Contains(r.ApplicationId)" disabled="@TableLocked" @onchange="e => Toggle(r.ApplicationId, e)" /></td>
                            <td class="c-rank" data-label="Hạng">
                                <span class="rank @(scored && r.Rank == 1 ? "gold" : null)">@RankingView.RankText(scored ? r.Rank : null)</span>
                            </td>
                            <td class="c-who">
                                <div class="who">
                                    <span class="avatar" aria-hidden="true">@RankingView.Initials(r.CandidateName, r.FileName)</span>
                                    <span class="who-text">
                                        <a class="name" href="@DetailUrl(r.EvaluationId)">@(r.CandidateName ?? "Chưa rõ tên ứng viên")</a>
                                        <span class="file" title="@r.FileName">@r.FileName</span>
                                        @if (failed) { <span class="processing-error">@Display.SafeError(r.ErrorMessage)</span> }
                                    </span>
                                </div>
                            </td>
                            <td class="c-must" data-label="Bắt buộc">
                                @if (must is null)
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    <span class="must @must.CssClass" title="@must.Detail">
                                        <span class="must-text">
                                            <span class="must-icon" aria-hidden="true">@(must.CssClass == "must-ok" ? "✓" : must.CssClass == "must-missing" ? "!" : "–")</span>
                                            @must.Text
                                        </span>
                                        @if (must.ShowDots)
                                        {
                                            <span class="dots" aria-hidden="true">
                                                @for (var i = 0; i < must.Total; i++)
                                                {
                                                    <span class="d @(i < must.Matched ? "on" : null)"></span>
                                                }
                                            </span>
                                        }
                                        <span class="visually-hidden">@must.Detail</span>
                                    </span>
                                }
                            </td>
                            <td class="c-num" data-label="Kinh nghiệm">@RankingView.Years(r.YearsExperience)</td>
                            <td class="c-bar" data-label="Điểm keyword / AI">
                                <ScoreBar Keyword="@(scored ? r.KeywordScore : null)" Final="@(scored ? r.FinalScore : null)" Threshold="PassThreshold" ScoreSource="@r.ScoreSource" />
                                <span class="parts">
                                    KW @RankingView.Score(scored ? r.KeywordScore : null) · AI
                                    <span title="@(keywordOnly ? "AI chưa chấm được CV này, điểm cuối chỉ tính theo từ khóa." : null)">@RankingView.Score(scored && !keywordOnly ? r.AiScore : null)</span>
                                </span>
                            </td>
                            <td class="c-num c-final" data-label="Điểm cuối">
                                <strong class="final">@RankingView.Score(scored ? r.FinalScore : null)</strong>
                            </td>
                            <td class="c-fit" data-label="Mức phù hợp">
                                <FitBadge FitLabel="@r.FitLabel" FinalScore="r.FinalScore" Status="@(failed ? EvaluationStatuses.Failed : r.Status)" ScoreSource="@r.ScoreSource" Message="@r.ErrorMessage" />
                                @if (scored)
                                {
                                    <span class="pass @(r.PredictedPass == true ? "is-pass" : null)">@(r.PredictedPass == true ? "Dự đoán Đạt" : "Dự đoán Không đạt")</span>
                                }
                                else
                                {
                                    <span class="no-score">Chưa có điểm</span>
                                }
                            </td>
                            <td class="c-stage" data-label="Giai đoạn">
                                <select id="stage-select-@r.ApplicationId" class="stage-select @StageText.Css(StageOf(r))" aria-label="@($"Giai đoạn hồ sơ {r.ApplicationId}: {r.CandidateName ?? r.FileName}")" value="@StageOf(r)" disabled="@TableLocked" @key="(r.ApplicationId, selectVersion, StageOf(r))" @onchange="e => RequestRowAsync(r, e)">
                                    @foreach (var stage in ApplicationStages.All) { <option value="@stage">@StageText.Name(stage)</option> }
                                </select>
                                @if (StageOf(r) == ApplicationStages.Rejected && ReasonOf(r) is { } reason)
                                {
                                    <button id="stage-reason-@r.ApplicationId" type="button" class="reason-edit" disabled="@TableLocked" aria-label="@($"Đổi lý do loại hồ sơ {r.ApplicationId}")" @onclick="() => RequestRowAsync(r, new ChangeEventArgs { Value = ApplicationStages.Rejected })">@StageText.Reason(reason) <span aria-hidden="true">↗</span></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (rows.Count == 0)
            {
                <div class="table-empty" role="status">
                    <p class="empty-title">Không có CV nào khớp bộ lọc</p>
                    <button type="button" class="btn sc-btn-secondary" @onclick="ResetFilters">Xóa bộ lọc</button>
                </div>
            }
        </div>

        <div class="ranking-foot" aria-live="polite"><span>Hiển thị @rows.Count/@Items.Count CV</span><span>Người thao tác: <strong>@(ActorState.Actor ?? "Chưa nhập tên HR")</strong> <button id="change-hr" type="button" class="actor-edit" disabled="@TableLocked" @onclick="() => editingActor = true">Đổi tên</button></span></div>
        @if (ActorState.StorageWarning is { } storageWarning) { <p class="actor-warning" role="status">@storageWarning</p> }
    }
</section>

@if (pending is not null && showDecisionDialog)
{
    <StageDialog ToStage="@pending.ToStage" Title="@DialogTitle" Actor="@ActorState.Actor" InitialReason="@DialogReason" Busy="busy" OnConfirm="ConfirmDecisionAsync" OnCancel="CancelPendingAsync" />
}
@if (editingActor)
{
    <StageDialog Title="Tên người thực hiện quyết định" ActorOnly="true" Actor="@ActorState.Actor" OnConfirm="SaveActorAsync" OnCancel="() => editingActor = false" />
}

@code {
    [Parameter, EditorRequired] public List<RankingItemDto> Items { get; set; } = [];
    [Parameter] public decimal PassThreshold { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public int? RunId { get; set; }
    [Parameter] public int? JobId { get; set; }

    private string DetailUrl(int id) => $"/results/evaluations/{id}" + Display.BackUrl(RunId?.ToString(), JobId?.ToString())["/results".Length..];

    private string search = string.Empty;
    private RankingFilter filter = RankingFilter.All;
    private RankingSort sort = RankingSort.FinalDesc;

    /// <summary>Số CV có nhãn mức từ API cần kiểm tra (không khớp điểm hoặc không hợp lệ) — B8 báo, không tự sửa.</summary>
    private int IssueCount => Items.Count(i => i.Status == EvaluationStatuses.Completed
                                               && FitLevel.Resolve(i.FitLabel, i.FinalScore)?.HasIssue == true);

    [Parameter] public List<RunItemDto> ProgressItems { get; set; } = [];
    private bool IsFailed(RankingItemDto r) => r.Status == EvaluationStatuses.Failed
        || ProgressItems.Any(p => p.EvaluationId == r.EvaluationId && p.ExtractionStatus == ExtractionStatuses.Failed);

    private string? RowClass(RankingItemDto r, bool scored) =>
        IsFailed(r) ? "is-unscored is-failed" : scored ? null : "is-unscored";

    private void ClearSearch() { search = string.Empty; selected.Clear(); }

    private void ResetFilters()
    {
        search = string.Empty;
        filter = RankingFilter.All;
        stageFilter = null;
        selected.Clear();
    }
}

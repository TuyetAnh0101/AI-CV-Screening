@page "/change-password"
@*
    B29: đổi mật khẩu (A30 POST /api/auth/change-password).
    - Chính sách SignedIn (không phải chính sách nghiệp vụ): tài khoản đang dùng mật khẩu tạm VẪN mở được trang này, nên mọi
      trang khác đưa về đây (NotAuthorizedContent) mà không có vòng lặp. Chưa đăng nhập / chưa xác minh → như mọi trang.
    - Hai luồng: BẮT BUỘC (mật khẩu tạm — khung trống, không menu, không gọi API nghiệp vụ, chỉ có Đăng xuất) và TỰ NGUYỆN
      (trong ứng dụng, có nút Hủy).
    - Thành công: token mới thay token cũ trong AuthSession TRƯỚC khi có request nào khác; request cũ trả 401 về sau không xóa
      phiên mới (AuthSession so token). Kết quả không rõ: chỉ kiểm tra bằng /api/auth/me, không gửi lại.
    Logic ở Helpers/ChangePasswordForm.cs (có test).
    Vị trí: Components/Account (KHÔNG phải Components/Pages) — [Authorize] mặc định của Pages/_Imports.razor là chính sách nghiệp vụ,
    và nhiều [Authorize] được kết hợp bằng AND: nếu nằm trong Pages, tài khoản mật khẩu tạm bị chặn ngay tại trang đổi mật khẩu.
*@
@attribute [Authorize(Policy = AccessRules.SignedInPolicy)]
@implements IDisposable
@inject AuthSession Session
@inject IAuthApi AuthApi
@inject AuthNavigator Navigator
@inject AccountNotice Notice
@inject NavigationManager Nav
@inject TimeProvider Time

<PageTitle>Đổi mật khẩu · SCApp</PageTitle>

<div class="cp-page @(forced ? "is-forced" : "is-voluntary")">
    @if (doneReturnUrl is not null)
    {
        <section class="cp-card cp-done" aria-labelledby="cp-title">
            <span class="cp-icon is-success" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="@CheckIcon" /></svg>
            </span>
            <h1 id="cp-title" tabindex="-1">Đã đổi mật khẩu</h1>
            <p class="cp-lead">Mật khẩu mới đã có hiệu lực. Các phiên đăng nhập khác của tài khoản này đã kết thúc; phiên hiện tại tiếp tục bằng thông tin đăng nhập mới.</p>
            <a class="btn sc-btn-primary cp-submit" href="@doneReturnUrl" @ref="doneLink">@(doneReturnUrl == "/" ? "Vào Tổng quan" : "Tiếp tục")</a>
        </section>
    }
    else
    {
        <section class="cp-card" aria-labelledby="cp-title">
            <header class="cp-head">
                <span class="cp-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M7 14a5 5 0 1 1 4.6-7H22v4h-2v3h-3v-3h-5.4A5 5 0 0 1 7 14zm0-3a2 2 0 1 0 0-4a2 2 0 0 0 0 4z" /></svg>
                </span>
                @if (forced)
                {
                    <p class="cp-eyebrow">Bước bắt buộc</p>
                    <h1 id="cp-title" tabindex="-1">Đặt mật khẩu mới</h1>
                    <p class="cp-lead">Bạn đang dùng mật khẩu tạm do quản trị viên cấp. Hãy đặt mật khẩu riêng để bắt đầu sử dụng SCApp.</p>
                }
                else
                {
                    <h1 id="cp-title" tabindex="-1">Đổi mật khẩu</h1>
                    <p class="cp-lead">Sau khi đổi, các phiên đăng nhập khác của tài khoản này sẽ kết thúc.</p>
                }
            </header>

            @if (form.FormError is { } error)
            {
                <div class="cp-notice @(NoticeCss)" role="alert" tabindex="-1" @ref="noticeRef">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@(resolution == UnknownResolution.NotChanged ? InfoIcon : AlertIcon)" /></svg>
                    <div>
                        <p>@error</p>
                        @if (checkingUnknown)
                        {
                            <p class="cp-checking"><span class="cp-spinner" aria-hidden="true"></span> Đang kiểm tra trạng thái…</p>
                        }
                        else if (resolution is UnknownResolution.ProbablyChanged or UnknownResolution.StillUnknown)
                        {
                            <div class="cp-notice-actions">
                                @if (resolution == UnknownResolution.StillUnknown)
                                {
                                    <button type="button" class="btn sc-btn-secondary" @onclick="ResolveAsync">Kiểm tra lại</button>
                                }
                                <button type="button" class="btn sc-btn-primary" @onclick="Navigator.SignOutAsync">Đăng nhập lại</button>
                            </div>
                        }
                    </div>
                </div>
            }

            <form class="cp-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate aria-busy="@(form.Submitting ? "true" : "false")">
                @* Giúp trình quản lý mật khẩu biết mật khẩu mới thuộc tài khoản nào (không hiển thị, không gửi đi). *@
                <input type="email" class="visually-hidden" autocomplete="username" value="@email" readonly tabindex="-1" aria-hidden="true" />

                <PasswordInput @ref="currentInput" Id="cp-current" Label="Mật khẩu hiện tại" Autocomplete="current-password"
                               Value="@form.Current" ValueChanged="v => form.Current = v" Show="form.ShowCurrent" ShowChanged="v => form.ShowCurrent = v"
                               Error="@form.CurrentError" ReadOnly="@Locked"
                               Hint="@(forced ? "Mật khẩu tạm bạn vừa dùng để đăng nhập." : null)" />

                <PasswordInput @ref="newInput" Id="cp-new" Label="Mật khẩu mới" Autocomplete="new-password"
                               Value="@form.New" ValueChanged="v => form.New = v" Show="form.ShowNew" ShowChanged="v => form.ShowNew = v"
                               Error="@form.NewError" ReadOnly="@Locked" ExtraDescribedBy="cp-rules">
                    <ul id="cp-rules" class="cp-rules" aria-label="Yêu cầu của mật khẩu mới">
                        @foreach (var rule in form.Rules(email))
                        {
                            <li class="@(rule.Met ? "is-met" : null)">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="@(rule.Met ? RuleMetIcon : RuleIcon)" /></svg>
                                <span>@rule.Text</span><span class="visually-hidden">@(rule.Met ? ": đạt" : ": chưa đạt")</span>
                            </li>
                        }
                    </ul>
                </PasswordInput>

                <PasswordInput @ref="confirmInput" Id="cp-confirm" Label="Nhập lại mật khẩu mới" Autocomplete="new-password"
                               Value="@form.Confirm" ValueChanged="v => form.Confirm = v" Show="form.ShowConfirm" ShowChanged="v => form.ShowConfirm = v"
                               Error="@form.ConfirmError" ReadOnly="@Locked" />

                <button type="submit" class="btn sc-btn-primary cp-submit" disabled="@(!form.CanSubmit)" @ref="submitRef">
                    @if (form.Submitting)
                    {
                        <span class="cp-spinner on-dark" aria-hidden="true"></span><span>Đang lưu…</span>
                    }
                    else if (form.IsRateLimited)
                    {
                        <span>Thử lại sau @form.RetrySecondsLeft giây</span>
                    }
                    else
                    {
                        <span>Lưu mật khẩu mới</span>
                    }
                </button>
            </form>

            <footer class="cp-foot">
                @if (forced)
                {
                    <p>Không đổi lúc này?</p>
                    <button type="button" class="cp-link" @onclick="Navigator.SignOutAsync" disabled="@form.Submitting">Đăng xuất</button>
                }
                else
                {
                    <a class="cp-link" href="@cancelUrl">Hủy và quay lại</a>
                }
            </footer>
        </section>
    }
</div>

@code {
    private const string InfoIcon = "M12 2a10 10 0 1 1 0 20a10 10 0 0 1 0-20zm-1 8v7h2v-7zm0-3v2h2V7z";
    private const string AlertIcon = "M12 2 1 21h22zm-1 7v6h2V9zm0 8v2h2v-2z";
    private const string CheckIcon = "M9.5 16.2 5.3 12l-1.4 1.4 5.6 5.6L21 7.5l-1.4-1.4z";
    private const string RuleIcon = "M12 4a8 8 0 1 1 0 16a8 8 0 0 1 0-16zm0 2a6 6 0 1 0 0 12a6 6 0 0 0 0-12z";
    private const string RuleMetIcon = "M12 2a10 10 0 1 1 0 20a10 10 0 0 1 0-20zm-1.2 13.6 6.3-6.3-1.4-1.4-4.9 4.9-2.3-2.3-1.4 1.4z";

    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private ChangePasswordForm form = default!;
    private bool forced;
    private string? email;
    private string cancelUrl = "/";
    private string? doneReturnUrl;
    private UnknownResolution? resolution;
    private bool checkingUnknown, focusNotice, focusDone;
    private string? pendingToken;
    private PasswordInput? currentInput, newInput, confirmInput;
    private ElementReference submitRef, noticeRef, doneLink;
    private Timer? retryTimer;
    private readonly CancellationTokenSource cts = new();

    private bool Locked => form.Submitting || form.Unresolved;
    private string NoticeCss => resolution == UnknownResolution.NotChanged ? "is-info" : "is-danger";

    protected override void OnInitialized()
    {
        form = new ChangePasswordForm(Time);
        forced = Session.MustChangePassword;
        email = Session.User?.Email;
        cancelUrl = AuthText.AfterPasswordChange(ReturnUrl);
        // Đổi xong khi đang dùng mật khẩu tạm: khung trang chuyển từ "trống" sang "đầy đủ" nên trang được tạo lại — lấy kết quả.
        if (Notice.TakePasswordChanged() is { } done) { doneReturnUrl = done; focusDone = true; }
    }

    private async Task SubmitAsync()
    {
        if (!form.CanSubmit) return;
        var token = await Session.GetAccessTokenAsync();
        if (token is null) return;                       // phiên đã hết: AuthGate đưa về /login?expired=1
        resolution = null;
        ChangePasswordOutcome outcome;
        try { outcome = await form.SubmitAsync(AuthApi, token, email, cts.Token); }
        catch (OperationCanceledException) { return; }

        switch (outcome)
        {
            case ChangePasswordOutcome.Changed:
                var r = form.Result!;
                var target = AuthText.AfterPasswordChange(ReturnUrl);
                Notice.PasswordChanged(target);
                doneReturnUrl = target; focusDone = true;
                // Token mới vào phiên trước mọi request khác; token cũ đã hết hiệu lực trên máy chủ.
                await Session.SignInAsync(new LoginResponse { Token = r.Token, ExpiresAt = r.ExpiresAt, User = r.User });
                break;
            case ChangePasswordOutcome.SessionEnded:
                await Session.HandleUnauthorizedAsync(token);
                break;
            case ChangePasswordOutcome.Unknown:
                pendingToken = token;
                focusNotice = true;
                await ResolveAsync();
                break;
            case ChangePasswordOutcome.RateLimited:
                StartRetryTimer();
                focusNotice = true;
                break;
            case ChangePasswordOutcome.Failed:
                focusNotice = true;
                break;
        }
    }

    /// <summary>Kết quả không rõ: chỉ ĐỌC /api/auth/me bằng token cũ để biết mật khẩu đã đổi chưa. Không gửi lại thao tác đổi.</summary>
    private async Task ResolveAsync()
    {
        if (pendingToken is null || checkingUnknown) return;
        checkingUnknown = true;
        StateHasChanged();
        try { resolution = await form.ResolveUnknownAsync(AuthApi, pendingToken, cts.Token); }
        catch (OperationCanceledException) { return; }
        finally { checkingUnknown = false; }
        if (resolution == UnknownResolution.NotChanged) pendingToken = null;
    }

    private void StartRetryTimer()
    {
        retryTimer?.Dispose();
        retryTimer = new Timer(_ => InvokeAsync(() =>
        {
            form.ClearExpiredRateLimit();
            if (!form.IsRateLimited) { retryTimer?.Dispose(); retryTimer = null; }
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (focusDone && doneReturnUrl is not null) { focusDone = false; await doneLink.FocusAsync(); return; }
            if (firstRender && currentInput is not null) { await currentInput.FocusAsync(); return; }
            if (focusNotice && form.FormError is not null) { focusNotice = false; await noticeRef.FocusAsync(); return; }
            var target = form.FocusTarget;
            if (target == PasswordField.None || form.Submitting) return;
            form.ClearFocusTarget();
            await (target switch
            {
                PasswordField.Current when currentInput is not null => currentInput.FocusAsync(),
                PasswordField.New when newInput is not null => newInput.FocusAsync(),
                PasswordField.Confirm when confirmInput is not null => confirmInput.FocusAsync(),
                _ => submitRef.FocusAsync().AsTask()
            });
        }
        catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException) { }
    }

    public void Dispose()
    {
        form.ClearPasswords();
        if (doneReturnUrl is not null) Notice.TakePasswordChanged();   // không để thông báo cũ hiện ở lần mở sau
        retryTimer?.Dispose();
        cts.Cancel();
        cts.Dispose();
    }
}

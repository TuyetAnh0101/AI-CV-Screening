@*
    SCApp v2 – Bộ CV đánh giá theo 5 bước (B25: nằm ở trang /evaluation-sets, chỉ một chỗ dùng):
      1 Tạo bộ (nút "+ Tạo bộ CV" luôn hiện) · 2 Chọn CV đã quét (lọc, chọn nhiều, không upload lại, không trùng)
      3 Gán nhãn HR (Đạt / Không đạt / Chưa đánh giá) · 4 Kiểm tra bộ (+ độ tin cậy B25) · 5 Chạy Prompt Test (chỉ ở trang /prompts).
    Thành viên bộ tách khỏi nhãn HR (EvaluationSetMembers). Nhãn KHÔNG BAO GIỜ lấy từ dự đoán AI.
    EvaluationSetWorkspace giữ danh sách bộ và luồng tạo an toàn (không POST lại khi chưa xác minh).
    SetMembersWorkspace giữ thành viên, bản nháp nhãn và bước chọn CV của bộ đang mở.
*@
@using SmartCv.Core.Constants
@using SmartCv.Web.Components.Upload
@implements IDisposable
@inject PromptApiClient Api
@inject IServiceProvider Services

<section id="evaluation-set-manager" class="set-studio" aria-labelledby="set-manager-title" aria-busy="@(Busy ? "true" : "false")">
    <header class="studio-head">
        <div>
            <p class="eyebrow">Bước 1–4 · Chuẩn bị dữ liệu tham chiếu</p>
            <h2 id="set-manager-title">Bộ CV đánh giá</h2>
            <p>Tạo nhiều bộ, chọn CV đã quét và để HR tự kết luận Đạt / Không đạt. Không cần upload lại CV đã có.</p>
        </div>
        <div class="head-actions">
            @if (Services.GetService<AnonymityState>() is not null) { <AnonymousToggle /> }
            <button type="button" class="btn sc-btn-secondary" disabled="@Busy" @onclick="ReloadAsync">Tải lại</button>
            @if (CanCreate) { <button id="create-set-open" type="button" class="btn sc-btn-primary" disabled="@(Busy || creatingOpen)" @onclick="OpenCreate"><span aria-hidden="true">+</span> Tạo bộ CV</button> }
        </div>
    </header>

    @if (!sets.Loaded && sets.Busy) { <p role="status" class="muted-line">Đang tải bộ CV đánh giá...</p> }
    @if (sets.Error is not null) { <p class="set-error" role="alert">@sets.Error</p> }
    @if (sets.Message is not null) { <p class="set-success" role="status">@sets.Message</p> }

    @if (!CanCreate && sets.Loaded && sets.Sets.Count == 0)
    {
        @* B28: tạo bộ (POST /api/evaluation-sets) chỉ Admin (A29); HR thêm hồ sơ và gán nhãn sau khi đã có bộ. *@
        <p id="set-empty-hr" class="set-empty" role="status">Chưa có bộ CV đánh giá. Quản trị viên (Admin) tạo bộ; sau đó bạn có thể chọn CV đã quét và gán nhãn HR tại đây.</p>
    }

    @if (CanCreate && (creatingOpen || (sets.Loaded && sets.Sets.Count == 0)))
    {
        <form class="create-card" @onsubmit="CreateAsync" @onsubmit:preventDefault="true" aria-labelledby="create-set-title">
            <fieldset disabled="@(Busy || sets.CreationUncertain)">
                <legend id="create-set-title"><span class="step-no" aria-hidden="true">1</span> Tạo bộ CV mới</legend>
                @if (sets.Loaded && sets.Sets.Count == 0)
                {
                    <p class="set-empty">Chưa có bộ CV đánh giá. Tạo bộ đầu tiên, sau đó chọn các CV đã quét trong hệ thống. Không cần upload lại CV đã có.</p>
                }
                <div class="form-grid">
                    <label>Tên bộ CV <span class="req">*</span><input aria-label="Tên bộ CV mới" maxlength="150" required @bind="sets.Name" placeholder="Ví dụ: Backend junior – đợt 11/2026" /></label>
                    <label>Vị trí tuyển dụng<select aria-label="Vị trí tuyển dụng của bộ" value="@(sets.JobId?.ToString() ?? "")" @onchange="e => sets.JobId = int.TryParse(e.Value?.ToString(), out var j) ? j : null"><option value="">Nhiều vị trí / chưa chọn</option>@foreach (var job in jobs) { <option value="@job.JobId">@job.Title@(job.IsActive ? "" : " · Ngừng tuyển")</option> }</select></label>
                    <label class="wide">Mục tiêu<input aria-label="Mục tiêu của bộ CV" maxlength="300" @bind="sets.Purpose" placeholder="Ví dụ: Kiểm tra prompt mới có bỏ sót ứng viên tốt không" /></label>
                    <label class="wide">Mô tả<input aria-label="Mô tả bộ CV" maxlength="500" @bind="sets.Description" placeholder="Phạm vi, nguồn CV, lưu ý cho người gán nhãn" /></label>
                </div>
                <div class="form-actions">
                    @if (sets.Sets.Count > 0) { <button type="button" class="btn sc-btn-secondary" @onclick="() => creatingOpen = false">Hủy</button> }
                    <button id="create-set-submit" type="submit" class="btn sc-btn-primary">Tạo bộ CV</button>
                </div>
                <p class="hint">Bộ chưa hoàn thiện vẫn được lưu; bạn có thể quay lại thêm hồ sơ và gán nhãn sau.</p>
            </fieldset>
        </form>
    }

    @if (sets.Sets.Count > 0)
    {
        <div class="set-list" role="list" aria-label="Các bộ CV đánh giá">
            @foreach (var set in sets.Sets)
            {
                var on = set.EvaluationSetId == members.SetId;
                var ready = set.LabelCount > 0 && set.PassCount > 0 && set.PassCount < set.LabelCount && set.UnreadyCount == 0;
                var cardHealth = EvaluationSetHealth.Assess(set.LabelCount, set.PassCount, failedExtractionCount: set.UnreadyCount);
                var marginText = cardHealth.MarginOfError is { } cardMargin ? $" · sai số ±{cardMargin.ToString("0.#", Vi)}" : "";
                var passShare = set.LabelCount > 0 ? Math.Round(100m * Math.Min(set.PassCount, set.LabelCount) / set.LabelCount, 1) : 0m;
                <button type="button" role="listitem" class="set-card verdict-@cardHealth.LevelCss @(on ? "on" : null)" aria-pressed="@(on ? "true" : "false")" disabled="@Busy" @onclick="() => SelectAsync(set.EvaluationSetId)">
                    <span class="set-card-top"><strong>@set.Name</strong><span class="chip health-@cardHealth.LevelCss">@cardHealth.LevelText</span></span>
                    <span class="set-card-meta">@(set.JobTitle ?? "Nhiều vị trí") · Phiên bản @set.Revision · @set.RunCount lượt chạy</span>
                    @if (set.LabelCount > 0)
                    {
                        <span class="card-ratio" aria-hidden="true"><span style="@($"width:{passShare.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></span></span>
                    }
                    <span class="set-card-stats"><b>@set.LabelCount</b> CV có nhãn · <b>@set.PassCount</b> Đạt · <b>@Math.Max(0, set.LabelCount - set.PassCount)</b> Không đạt<span>@marginText</span></span>
                    <span class="set-card-stats"><b>@set.MemberCount</b> hồ sơ · <b>@set.UnlabeledCount</b> chưa gán</span>
                    @if (!ready) { <span class="set-card-warn">Chưa đủ điều kiện chạy Prompt Test</span> }
                </button>
            }
        </div>
    }

    @if (pendingSet is not null)
    {
        <div role="alert" class="set-empty discard">Bạn có nhãn/ghi chú chưa lưu trong bộ đang mở. <button type="button" class="btn sc-btn-secondary" @onclick="() => pendingSet = null">Giữ bản nháp</button> <button type="button" class="btn sc-btn-secondary" @onclick="DiscardAndSwitchAsync">Bỏ bản nháp và chuyển</button></div>
    }

    @if (members.Detail is { } detail && members.Loaded)
    {
        var readiness = members.Readiness;
        <div class="set-workspace">
            <div class="workspace-title">
                <div><h3>@detail.Name</h3><p>@(detail.JobTitle ?? "Nhiều vị trí")@(string.IsNullOrWhiteSpace(detail.Purpose) ? "" : " · " + detail.Purpose) · Phiên bản bộ @detail.Revision</p></div>
                <a id="run-test-link" class="btn sc-btn-secondary" href="@($"/prompts?set={detail.EvaluationSetId}#prompt-test-panel")"><span class="step-no" aria-hidden="true">5</span> Chạy Prompt Test ở trang System Prompt</a>
            </div>

            <section class="readiness" aria-label="Bước 4: Kiểm tra bộ dữ liệu">
                <h4><span class="step-no" aria-hidden="true">4</span> Kiểm tra bộ dữ liệu</h4>
                <dl class="stat-row">
                    <div><dt>Tổng hồ sơ</dt><dd>@readiness.MemberCount</dd></div>
                    <div><dt>Đã gán nhãn</dt><dd>@readiness.LabeledCount</dd></div>
                    <div class="ok"><dt>Đạt</dt><dd>@readiness.PassCount</dd></div>
                    <div class="bad"><dt>Không đạt</dt><dd>@readiness.FailCount</dd></div>
                    <div><dt>Chưa gán nhãn</dt><dd>@readiness.UnlabeledCount</dd></div>
                    <div class="@(readiness.NotReadyCount > 0 ? "warn" : null)"><dt>Chưa đủ điều kiện</dt><dd>@readiness.NotReadyCount</dd></div>
                </dl>
                @if (readiness.CanRun) { <p class="ready-line" role="status"><span aria-hidden="true">✓</span> Bộ đủ điều kiện chạy Prompt Test trên @readiness.LabeledCount hồ sơ có nhãn.</p> }
                @foreach (var blocker in readiness.Blockers) { <p class="blocker">@blocker</p> }
                @foreach (var warning in readiness.Warnings) { <p class="hint warn-line">@warning</p> }
                @{ var health = SelectedHealth(readiness); }
                <div id="set-health" class="health health-@health.LevelCss" aria-label="Độ tin cậy của bộ để so sánh prompt">
                    <div class="health-head">
                        <span class="health-verdict"><span class="health-icon" aria-hidden="true">@HealthIcon(health.Level)</span>@health.LevelText</span>
                        @if (health.MarginOfError is { } margin) { <span class="health-margin" title="Nửa độ rộng khoảng tin cậy 95% (Wilson) khi prompt đúng khoảng 80% trên bộ này">Sai số tỷ lệ đúng ≈ ±@margin.ToString("0.#", Vi) điểm %</span> }
                    </div>
                    @if (health.Total > 0)
                    {
                        var passPercent = Math.Round(100m * health.Pass / health.Total, 1);
                        <div class="ratio" role="img" aria-label="@($"Tỷ lệ nhãn: {health.Pass} Đạt, {health.Fail} Không đạt")">
                            <span class="ratio-pass" style="@($"width:{passPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></span>
                        </div>
                        <p class="ratio-legend"><span>Đạt <b>@health.Pass</b> (@passPercent.ToString("0.#", Vi)%)</span><span>Không đạt <b>@health.Fail</b></span></p>
                    }
                    @if (health.Issues.Count > 0)
                    {
                        <ul class="health-issues">
                            @foreach (var issue in health.Issues) { <li class="issue-@issue.Severity.ToString().ToLowerInvariant()"><span class="issue-tag">@IssueText(issue.Severity)</span> @issue.Text</li> }
                        </ul>
                    }
                    else { <p class="hint">Bộ đủ cỡ và cân bằng nhãn để so sánh hai phiên bản prompt.</p> }
                </div>
            </section>

            @SetInsights

            <div class="tabs" role="tablist" aria-label="Thao tác với bộ CV">
                <button id="tab-labels" type="button" role="tab" aria-selected="@(tab == Tab.Labels ? "true" : "false")" class="tab @(tab == Tab.Labels ? "on" : null)" @onclick="() => tab = Tab.Labels"><span class="step-no" aria-hidden="true">3</span> Gán nhãn HR <span class="count">@readiness.MemberCount</span></button>
                <button id="tab-picker" type="button" role="tab" aria-selected="@(tab == Tab.Picker ? "true" : "false")" class="tab @(tab == Tab.Picker ? "on" : null)" @onclick="OpenPickerAsync"><span class="step-no" aria-hidden="true">2</span> Thêm CV đã quét</button>
            </div>

            @if (members.Error is not null) { <p class="set-error" role="alert">@members.Error</p> }
            @if (members.Message is not null) { <p class="set-success" role="status">@members.Message</p> }
            @foreach (var w in members.Warnings) { <p class="hint warn-line">@w</p> }

            @if (tab == Tab.Picker)
            {
                <section class="picker" role="tabpanel" aria-labelledby="tab-picker">
                    <p class="hint">Mỗi dòng là một <strong>hồ sơ ứng tuyển</strong> (một CV nộp vào một Job). Một CV nộp hai Job là hai hồ sơ khác nhau. CV chưa gán Job chưa có hồ sơ: hãy mở <a href="/candidates?view=cvs">Ứng viên › Hồ sơ CV</a> để gán Job trước.</p>
                    <div class="picker-filters">
                        <label class="grow">Tìm kiếm<input type="search" aria-label="Tìm hồ sơ để thêm" placeholder="@(Anonymity.Enabled ? "Tên file đã ẩn; tìm theo vị trí" : "Tên ứng viên, tên file, vị trí")" @bind="members.Search" @bind:event="oninput" /></label>
                        <label>Vị trí<select aria-label="Lọc theo vị trí" value="@(members.Filter.JobId?.ToString() ?? "")" @onchange="e => FilterAsync(members.Filter with { JobId = int.TryParse(e.Value?.ToString(), out var j) ? j : null })"><option value="">Tất cả vị trí</option>@foreach (var job in jobs) { <option value="@job.JobId">@job.Title</option> }</select></label>
                        <label>Giai đoạn<select aria-label="Lọc theo giai đoạn" value="@(members.Filter.Stage ?? "")" @onchange="e => FilterAsync(members.Filter with { Stage = e.Value?.ToString() is { Length: > 0 } s ? s : null })"><option value="">Tất cả</option>@foreach (var stage in ApplicationStages.All) { <option value="@stage">@StageText.Name(stage)</option> }</select></label>
                        <label>Từ ngày<input type="date" aria-label="Ứng tuyển từ ngày" value="@Date(members.Filter.From)" @onchange="e => FilterAsync(members.Filter with { From = ParseDate(e.Value) })" /></label>
                        <label>Đến ngày<input type="date" aria-label="Ứng tuyển đến ngày" value="@Date(members.Filter.To)" @onchange="e => FilterAsync(members.Filter with { To = ParseDate(e.Value) })" /></label>
                    </div>
                    @if (!members.CandidatesLoaded && members.Busy) { <p role="status" class="muted-line">Đang tải hồ sơ...</p> }
                    else if (members.CandidatesLoaded)
                    {
                        var visible = members.VisibleCandidates(c => Anonymity.Name(c.CandidateName, null, c.ApplicationId)).ToList();
                        var selectable = visible.Where(c => !c.IsAnonymized).ToList();
                        <div class="picker-bar">
                            <label class="check"><input type="checkbox" aria-label="Chọn mọi hồ sơ đang hiển thị" checked="@(selectable.Count > 0 && selectable.All(c => members.Selected.Contains(c.ApplicationId)))" disabled="@(Busy || selectable.Count == 0)" @onchange="e => ToggleAll(selectable, e)" /> Chọn tất cả đang hiển thị (@selectable.Count)</label>
                            <span class="muted-line">Đã chọn <strong>@members.Selected.Count</strong></span>
                        </div>
                        @if (visible.Count == 0)
                        {
                            <p class="set-empty">Không còn hồ sơ phù hợp bộ lọc (hồ sơ đã thuộc bộ được ẩn). <a href="/upload">Tải CV và gán Job</a> hoặc đổi bộ lọc.</p>
                        }
                        else
                        {
                            <ul class="pick-list">
                                @foreach (var c in visible)
                                {
                                    var reason = c.IsAnonymized ? "Đã ẩn danh" : c.ExtractionStatus != "Completed" ? "CV chưa đọc xong" : !c.HasExtractedText ? "CV không có chữ" : null;
                                    <li @key="c.ApplicationId" class="@(members.Selected.Contains(c.ApplicationId) ? "on" : null)">
                                        <label class="pick">
                                            <input type="checkbox" aria-label="@($"Chọn hồ sơ {c.ApplicationId} để thêm")" checked="@members.Selected.Contains(c.ApplicationId)" disabled="@(Busy || c.IsAnonymized)" @onchange="e => members.Toggle(c.ApplicationId, e.Value is true)" />
                                            <span class="pick-main"><strong>@Anonymity.Name(c.CandidateName, null, c.ApplicationId)</strong><span>@Anonymity.FileName(c.FileName)</span></span>
                                            <span class="pick-meta"><span>@c.JobTitle · Hồ sơ #@c.ApplicationId</span><span>@StageText.Name(c.Stage) · @RankingView.VnTime(c.AppliedAt)</span></span>
                                            @if (reason is not null) { <span class="chip chip-warn">@reason</span> }
                                        </label>
                                    </li>
                                }
                            </ul>
                        }
                        <div class="sticky-actions">
                            <p>Người thực hiện: <strong>@actor</strong></p>
                            <button id="add-members" type="button" class="btn sc-btn-primary" disabled="@(Busy || members.Selected.Count == 0)" @onclick="AddAsync">Thêm @members.Selected.Count hồ sơ vào bộ</button>
                        </div>
                    }
                </section>
            }
            else
            {
                <section class="labels" role="tabpanel" aria-labelledby="tab-labels">
                    @if (members.Rows.Count == 0)
                    {
                        <div class="set-empty"><strong>Bộ chưa có hồ sơ.</strong> Chọn CV đã quét để thêm vào bộ. <button type="button" class="btn sc-btn-primary" @onclick="OpenPickerAsync">Chọn CV đã quét</button></div>
                    }
                    else
                    {
                        <p class="hint">HR tự đọc CV gốc và kết luận. Kết quả AI không được dùng làm nhãn. Hồ sơ chưa sẵn sàng chưa gán nhãn được.</p>
                        <ul class="member-list">
                            @foreach (var row in members.Rows)
                            {
                                var m = row.Member;
                                <li @key="m.ApplicationId" class="member @(row.IsDirty ? "dirty" : null) @(m.IsReady ? null : "not-ready")">
                                    <div class="member-who">
                                        <strong>@Anonymity.Name(m.CandidateName, null, m.ApplicationId)</strong>
                                        <span>@Anonymity.FileName(m.FileName) · @m.JobTitle · Hồ sơ #@m.ApplicationId</span>
                                        @if (!m.IsReady) { <span class="chip chip-warn">@m.NotReadyReason</span> }
                                        <span class="member-links">
                                            @if (m.IsReady && m.CvId != Guid.Empty) { <CvFileButton CvId="m.CvId" Text="Xem CV gốc" /> }
                                            @if (m.CvId != Guid.Empty && !m.IsAnonymized) { <button id="@($"text-{m.ApplicationId}")" type="button" class="link-btn" @onclick="() => textMember = m">Nội dung đã trích xuất</button> }
                                        </span>
                                    </div>
                                    <fieldset class="label-choice" disabled="@(Busy || !m.IsReady)">
                                        <legend class="visually-hidden">Nhãn HR hồ sơ @m.ApplicationId</legend>
                                        @foreach (var (value, text) in Choices)
                                        {
                                            <label class="seg @(row.Choice == value ? "on" : null) seg-@(value.Length == 0 ? "none" : value)"><input type="radio" name="@($"label-{m.ApplicationId}")" value="@value" aria-label="@($"{text} – hồ sơ {m.ApplicationId}")" checked="@(row.Choice == value)" @onchange="() => { row.Choice = value; NotifyDirty(); }" />@text</label>
                                        }
                                    </fieldset>
                                    <div class="member-note">
                                        @if (Anonymity.Enabled) { <span class="muted-line">Ghi chú được ẩn khi bật Ẩn danh.</span> }
                                        else if (row.Choice.Length > 0) { <textarea aria-label="@($"Ghi chú HR hồ sơ {m.ApplicationId}")" maxlength="500" rows="2" disabled="@(Busy || !m.IsReady)" placeholder="Nhận xét của HR (không bắt buộc)" @bind="row.Note" @bind:event="oninput" @bind:after="NotifyDirty"></textarea> }
                                        @if (m.LabeledBy is not null && m.LabeledAt is { } labeledAt) { <span class="muted-line">Gán bởi @m.LabeledBy · @RankingView.VnTime(labeledAt)</span> }
                                    </div>
                                    <button type="button" class="icon-btn" aria-label="@($"Bỏ hồ sơ {m.ApplicationId} khỏi bộ")" title="Bỏ khỏi bộ" disabled="@Busy" @onclick="() => confirmRemove = m.ApplicationId">✕</button>
                                    @if (confirmRemove == m.ApplicationId)
                                    {
                                        <div class="inline-confirm" role="alert">Bỏ hồ sơ #@m.ApplicationId khỏi bộ? Nhãn HR của hồ sơ trong bộ này cũng bị bỏ; kết quả chấm đã lưu không thay đổi. <button type="button" class="btn sc-btn-secondary" @onclick="() => confirmRemove = null">Hủy</button> <button type="button" class="btn sc-btn-danger" @onclick="() => RemoveAsync(m.ApplicationId)">Bỏ khỏi bộ</button></div>
                                    }
                                </li>
                            }
                        </ul>
                        <div class="sticky-actions">
                            <p>Người thực hiện: <strong>@actor</strong></p>
                            <span class="muted-line">@(members.DirtyCount == 0 ? "Không có thay đổi" : $"{members.DirtyCount} thay đổi chưa lưu")</span>
                            <button id="save-labels" type="button" class="btn sc-btn-primary" disabled="@(Busy || members.DirtyCount == 0)" @onclick="SaveAsync">Lưu nhãn HR</button>
                        </div>
                    }
                    <LabelSuggestionPanel @key="members.SetId" State="CurrentSuggestions" Disabled="Busy" OnSaved="SuggestionsSavedAsync" OnDirtyChanged="_ => NotifyDirty()" />
                </section>
            }
        </div>
    }
</section>

@if (textMember is { } shown)
{
    <ExtractedTextDialog @key="shown.ApplicationId" CvId="shown.CvId" FileName="@Anonymity.FileName(shown.FileName)"
                         ReturnFocusIds="@([$"text-{shown.ApplicationId}", "tab-labels"])" OnClose="() => textMember = null" />
}

@code {
    private enum Tab { Labels, Picker }
    private static readonly (string Value, string Text)[] Choices = [(SetMembersWorkspace.Pass, "Đạt"), (SetMembersWorkspace.Fail, "Không đạt"), (SetMembersWorkspace.Unlabeled, "Chưa đánh giá")];
    [Parameter] public EventCallback<int> OnSaved { get; set; }
    [Parameter] public EventCallback<bool> OnDirtyChanged { get; set; }
    [Parameter] public int? EvaluationSetId { get; set; }
    [Parameter] public EventCallback<int> OnSetChanged { get; set; }
    /// <summary>B25: số bộ sau mỗi lần tải danh sách (trang dùng để mở sẵn hướng dẫn khi chưa có bộ).</summary>
    [Parameter] public EventCallback<int> OnSetsLoaded { get; set; }
    /// <summary>B25: nội dung trang chèn ngay sau bước 4 của bộ đang mở (lượt Prompt Test của bộ), để không bị đẩy xuống dưới danh sách hồ sơ.</summary>
    [Parameter] public RenderFragment? SetInsights { get; set; }
    private EvaluationSetWorkspace sets = default!;
    private SetMembersWorkspace members = default!;
    private AnonymityState Anonymity => anonymity ??= Services.GetService<AnonymityState>() ?? new();
    private AnonymityState? anonymity;
    private readonly CancellationTokenSource lifetime = new();
    private readonly Dictionary<int, LabelSuggestionWorkspace> suggestions = [];
    private List<JobDto> jobs = [];
    private bool creatingOpen, creating, lastDirty;
    private int? pendingSet, confirmRemove;
    private EvaluationSetMemberDto? textMember;
    private string actor = "";
    private Tab tab = Tab.Labels;
    private bool Busy => creating || sets.Busy || members.Busy;
    private LabelSuggestionWorkspace CurrentSuggestions
    { get { if (!suggestions.TryGetValue(members.SetId, out var s)) suggestions[members.SetId] = s = new(Api, members.SetId); return s; } }

    protected override async Task OnInitializedAsync()
    {
        Anonymity.Changed += PrivacyChanged;
        sets = new(Api); members = new(Api);
        if (Services.GetService<HrActorState>() is { } hr) { try { await hr.EnsureLoadedAsync(); } catch { } actor = hr.Actor ?? ""; }
        var jobLoad = LoadJobsAsync();
        await sets.LoadAsync(lifetime.Token);
        await jobLoad;
        if (sets.Loaded) await OnSetsLoaded.InvokeAsync(sets.Sets.Count);
        if (EvaluationSetId is > 0 && sets.Sets.Any(s => s.EvaluationSetId == EvaluationSetId)) await OpenSetAsync(EvaluationSetId.Value, notify: false);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!creating && sets.Loaded && EvaluationSetId is > 0 && EvaluationSetId != members.SetId && !members.IsDirty
            && sets.Sets.Any(s => s.EvaluationSetId == EvaluationSetId))
            await OpenSetAsync(EvaluationSetId.Value, notify: false);
    }

    private async Task LoadJobsAsync()
    {
        if (Services.GetService<JobApiClient>() is not { } jobApi) return;
        var result = await jobApi.GetJobsAsync(activeOnly: false, lifetime.Token);
        if (result.IsSuccess) jobs = result.Data!;
    }

    // B28: chỉ Admin tạo bộ CV (A29: POST /api/evaluation-sets). Thêm / bỏ hồ sơ, gán nhãn: cả HR.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool CanCreate => AccessRules.Can(AuthState, AppPermission.CreateEvaluationSet);

    private void OpenCreate() { if (CanCreate) creatingOpen = true; }

    private async Task ReloadAsync()
    {
        if (Busy) return;
        try
        {
            await sets.LoadAsync(lifetime.Token);
            if (sets.Loaded) await OnSetsLoaded.InvokeAsync(sets.Sets.Count);
            if (members.SetId > 0) await members.LoadAsync(members.SetId, lifetime.Token);
            if (tab == Tab.Picker) await members.LoadCandidatesAsync(lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private async Task CreateAsync()
    {
        if (Busy || !CanCreate) return;
        creating = true;
        try
        {
            await sets.CreateAsync(lifetime.Token);
            if (sets.Error is null && sets.SetId > 0)
            {
                await OnSetsLoaded.InvokeAsync(Math.Max(1, sets.Sets.Count));
                creatingOpen = false;
                creating = false;
                await OpenSetAsync(sets.SetId, notify: true, force: true);
                tab = Tab.Picker;
                await members.LoadCandidatesAsync(lifetime.Token);
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { creating = false; }
    }

    private async Task SelectAsync(int id)
    {
        if (Busy || id == members.SetId) return;
        if (members.IsDirty) { pendingSet = id; return; }
        await OpenSetAsync(id, notify: true);
    }

    private async Task DiscardAndSwitchAsync()
    {
        if (pendingSet is not { } id) return;
        pendingSet = null;
        await OpenSetAsync(id, notify: true, force: true);
    }

    private async Task OpenSetAsync(int id, bool notify, bool force = false)
    {
        if (!force && members.IsDirty) return;
        confirmRemove = null;
        try
        {
            await members.LoadAsync(id, lifetime.Token);
            if (members.SetId == id && tab == Tab.Picker) await members.LoadCandidatesAsync(lifetime.Token);
            NotifyDirty();
            if (notify && members.SetId == id) await OnSetChanged.InvokeAsync(id);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private async Task OpenPickerAsync()
    {
        tab = Tab.Picker;
        if (!members.CandidatesLoaded)
        {
            if (members.Filter.JobId is null && members.Detail?.JobId is { } job) members.Filter = members.Filter with { JobId = job };
            try { await members.LoadCandidatesAsync(lifetime.Token); } catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        }
    }

    private async Task FilterAsync(CandidatePickerFilter filter)
    {
        members.Filter = filter;
        try { await members.LoadCandidatesAsync(lifetime.Token); } catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private void ToggleAll(List<LabelCandidateDto> visible, ChangeEventArgs e)
    {
        foreach (var c in visible) members.Toggle(c.ApplicationId, e.Value is true);
    }

    private async Task AddAsync()
    {
        try
        {
            await RememberActorAsync();
            if (await members.AddSelectedAsync(actor, lifetime.Token)) await AfterWriteAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private async Task RemoveAsync(int applicationId)
    {
        confirmRemove = null;
        try { if (await members.RemoveAsync(applicationId, lifetime.Token)) await AfterWriteAsync(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private async Task SaveAsync()
    {
        try
        {
            await RememberActorAsync();
            var saved = await members.SaveLabelsAsync(actor, lifetime.Token);
            if (saved || members.Message is not null) await AfterWriteAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private async Task SuggestionsSavedAsync(int id)
    {
        if (id == members.SetId) await members.LoadAsync(id, lifetime.Token);
        await AfterWriteAsync();
    }

    /// <summary>Danh sách bộ (số liệu thẻ) và PromptTestPanel/lịch sử phải thấy ngay số mới.</summary>
    private async Task AfterWriteAsync()
    {
        await sets.LoadAsync(lifetime.Token);
        if (sets.Loaded) await OnSetsLoaded.InvokeAsync(sets.Sets.Count);
        NotifyDirty();
        await OnSaved.InvokeAsync(members.SetId);
    }

    private async Task RememberActorAsync()
    {
        if (Services.GetService<HrActorState>() is { } hr && !string.IsNullOrWhiteSpace(actor) && actor.Trim().Length <= 100)
            try { await hr.SetAsync(actor.Trim()); } catch { /* lưu tên chỉ là tiện ích */ }
    }

    private void NotifyDirty()
    {
        var dirty = members.IsDirty || suggestions.Values.Any(s => s.Draft.HasPending || s.NeedsVerification || s.Saving);
        if (dirty == lastDirty) return;
        lastDirty = dirty;
        _ = OnDirtyChanged.InvokeAsync(dirty);
    }

    private static readonly System.Globalization.CultureInfo Vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

    /// <summary>B25: đánh giá độ tin cậy từ nhãn ĐÃ LƯU (không tính bản nháp) và số vị trí của các hồ sơ có nhãn.</summary>
    private SetHealth SelectedHealth(EvaluationSetReadinessDto readiness)
    {
        var jobCount = members.Rows.Where(r => r.Member.IsPass is not null).Select(r => r.Member.JobId).Distinct().Count();
        return EvaluationSetHealth.Assess(readiness.LabeledCount, readiness.PassCount, jobCount, readiness.LabeledNotReadyCount);
    }
    private static string HealthIcon(SetHealthLevel level) => level switch { SetHealthLevel.Good => "✓", SetHealthLevel.Caution => "!", SetHealthLevel.Poor => "✕", _ => "–" };
    private static string IssueText(IssueSeverity severity) => severity switch { IssueSeverity.Severe => "Nghiêm trọng", IssueSeverity.Caution => "Cần lưu ý", _ => "Thông tin" };

    private static string Date(DateOnly? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "";
    private static DateOnly? ParseDate(object? value) => DateOnly.TryParseExact(value?.ToString(), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : null;
    private void PrivacyChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Anonymity.Changed -= PrivacyChanged; lifetime.Cancel(); lifetime.Dispose(); foreach (var s in suggestions.Values) s.Dispose(); }
}

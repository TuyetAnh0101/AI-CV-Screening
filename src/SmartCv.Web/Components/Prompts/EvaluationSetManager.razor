@implements IDisposable
@inject PromptApiClient Api

<section id="evaluation-set-manager" class="set-manager" aria-labelledby="set-manager-title" aria-busy="@(workspace.Busy ? "true" : "false")">
    <header><div><p class="eyebrow">1 · Chuẩn bị dữ liệu tham chiếu</p><h2 id="set-manager-title">Bộ CV &amp; nhãn HR</h2><p>Dùng hồ sơ đã upload và gán vào Job. HR tự đọc CV và đưa ra kết luận; nhãn này là chuẩn để kiểm tra AI.</p></div><button type="button" class="btn sc-btn-secondary" disabled="@workspace.Busy" @onclick="LoadAsync">@(workspace.Busy ? "Đang tải..." : "Tải lại danh sách bộ")</button></header>
    @if (!workspace.Loaded && workspace.Busy) { <p role="status">Đang tải bộ CV đánh giá...</p> }
    @if (workspace.Error is not null) { <p class="set-error" role="alert">@workspace.Error</p> }
    @if (workspace.Message is not null) { <p class="set-success" role="status">@workspace.Message</p> }
    @if (workspace.Loaded && workspace.Sets.Count == 0) { <p class="set-empty">Chưa có bộ CV đánh giá. Tạo tên bộ ở bước 1, sau đó gán nhãn ở bước 2. Không cần upload lại CV đã có.</p> }
    <details open="@(workspace.Sets.Count == 0)">
        <summary>Tạo bộ CV đánh giá</summary>
        <fieldset disabled="@(workspace.Busy || workspace.CreationUncertain)">
            <legend class="visually-hidden">Bước 1: Lưu tên bộ CV</legend>
            <div class="set-form"><label>Tên bộ CV<input aria-label="Tên bộ CV mới" maxlength="150" @bind="workspace.Name" placeholder="Ví dụ: Bộ CV Backend đợt 1" /></label><label>Mô tả<input aria-label="Mô tả bộ CV" maxlength="500" @bind="workspace.Description" placeholder="Mục tiêu và phạm vi đánh giá" /></label><button type="button" class="btn sc-btn-primary" @onclick="CreateAsync">1. Lưu tên bộ</button></div>
            <p class="hint">Tên bộ được lưu trước. Bạn có thể quay lại hoàn thiện nhãn; bộ chưa có đủ hai loại nhãn sẽ chưa chạy được.</p>
        </fieldset>
    </details>
    @if (workspace.Sets.Count > 0)
    {
        <div class="set-form"><label>Bộ CV cần gán nhãn<select aria-label="Bộ CV cần gán nhãn" value="@workspace.SetId" disabled="@workspace.Busy" @onchange="SelectAsync"><option value="0">Chọn bộ để tiếp tục</option>@foreach (var set in workspace.Sets) { <option value="@set.EvaluationSetId">@set.Name · @set.LabelCount nhãn</option> }</select></label></div>
    }
    @if (pendingSet is not null)
    {
        <p role="alert" class="set-empty">Chuyển bộ hoặc tải lại sẽ bỏ nhãn/ghi chú đang soạn. <button type="button" class="btn sc-btn-secondary" @onclick="() => pendingSet = null">Giữ bản nháp</button> <button type="button" class="btn sc-btn-secondary" @onclick="DiscardAsync">Bỏ bản nháp và tiếp tục</button></p>
    }
    @if (workspace.Selected is { } selected && workspace.CandidatesLoaded)
    {
        <h3>2. Chọn hồ sơ &amp; gán nhãn — @selected.Name</h3>
        <p class="hint">Chỉ hồ sơ trích xuất hoàn tất và có nội dung chữ mới được chọn. Mỗi dòng là một CV ứng tuyển một Job. Không có lựa chọn Đạt/Không đạt mặc định cho hồ sơ mới.</p>
        @if (workspace.Rows.Count == 0) { <p class="set-empty">Chưa có hồ sơ ứng tuyển. <a href="/upload">Tải CV và gán vào Job</a>, rồi quay lại tải lại danh sách bộ.</p> }
        else
        {
            <fieldset disabled="@workspace.Busy" @onchange="MarkDirty">
                <legend class="visually-hidden">Nhãn HR cho hồ sơ</legend>
                <div class="set-scroll" tabindex="0" role="region" aria-label="Hồ sơ gán nhãn HR, có thể cuộn ngang"><table><thead><tr><th scope="col">Hồ sơ / Job</th><th scope="col">Trích xuất</th><th scope="col">Kết luận HR</th><th scope="col">Ghi chú HR</th></tr></thead><tbody>
                    @foreach (var row in workspace.Rows)
                    {
                        <tr @key="row.Candidate.ApplicationId"><th scope="row"><strong>@(string.IsNullOrWhiteSpace(row.Candidate.CandidateName) ? "Chưa có tên ứng viên" : row.Candidate.CandidateName)</strong><span>@row.Candidate.FileName</span><span>@row.Candidate.JobTitle · Hồ sơ #@row.Candidate.ApplicationId</span>@if (row.Candidate.CvId != Guid.Empty) { <a href="@Api.EvaluationCvUrl(row.Candidate.CvId)" target="_blank" rel="noopener">Đọc CV gốc ↗</a> }</th>
                            <td>@row.Candidate.ExtractionStatus<span>@(row.Eligible ? "Sẵn sàng" : "Chưa đủ điều kiện: cần đọc lại hoặc chờ trích xuất")</span></td>
                            <td><select aria-label="@($"Nhãn HR hồ sơ {row.Candidate.ApplicationId}")" disabled="@(!row.Eligible)" @bind="row.Choice">@if (!row.HadLabel) { <option value="">Chưa gán nhãn</option> }<option value="pass">Đạt</option><option value="fail">Không đạt</option></select></td>
                            <td><textarea aria-label="@($"Ghi chú HR hồ sơ {row.Candidate.ApplicationId}")" maxlength="500" rows="2" disabled="@(!row.Eligible)" @bind="row.Note"></textarea></td></tr>
                    }
                </tbody></table></div>
                <div class="set-form"><label>Người gán nhãn<input aria-label="Người gán nhãn HR" maxlength="100" @bind="workspace.LabeledBy" /></label><button type="button" class="btn sc-btn-primary" @onclick="SaveAsync">Lưu nhãn HR &amp; dùng bộ CV</button></div>
                <p class="hint">Lưu bổ sung/cập nhật nhãn, không xóa nhãn cũ. Sửa nhãn HR có thể tính lại tỷ lệ của các lượt cũ; điểm AI đã lưu được giữ nguyên.</p>
            </fieldset>
        }
    }
</section>

@code {
    [Parameter] public EventCallback<int> OnSaved { get; set; }
    [Parameter] public EventCallback<bool> OnDirtyChanged { get; set; }
    private EvaluationSetWorkspace workspace = default!;
    private readonly CancellationTokenSource lifetime = new();
    private bool dirty;
    private int? pendingSet;
    protected override async Task OnInitializedAsync() { workspace = new(Api); await LoadAsync(); }
    private async Task MarkDirty() { dirty = true; await OnDirtyChanged.InvokeAsync(true); }
    private async Task ClearDirty() { dirty = false; await OnDirtyChanged.InvokeAsync(false); }
    private async Task LoadAsync()
    {
        if (dirty) { pendingSet = 0; return; }
        try { await workspace.LoadAsync(lifetime.Token); } catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    private async Task CreateAsync()
    {
        if (dirty) { pendingSet = -1; return; }
        try { await workspace.CreateAsync(lifetime.Token); } catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    private async Task SelectAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id) || id == workspace.SetId) return;
        if (dirty) { pendingSet = id; return; }
        try { await workspace.SelectAsync(id, lifetime.Token); } catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    private async Task DiscardAsync()
    {
        var id = pendingSet; pendingSet = null; await ClearDirty();
        if (id == 0) await LoadAsync(); else if (id == -1) await CreateAsync(); else await SelectAsync(new() { Value = id });
    }
    private async Task SaveAsync()
    {
        try { if (await workspace.SaveAsync(lifetime.Token)) { await ClearDirty(); await OnSaved.InvokeAsync(workspace.SetId); } }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}

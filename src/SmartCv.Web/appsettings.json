{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CvUpload": {
    "MaxFileSizeMB": 10,
    "MaxFilesPerRequest": 20,
    "MaxFilesPerSelection": 25,
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg" ]
  }
}

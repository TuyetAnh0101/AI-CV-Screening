
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CvUpload": {
    "Endpoint": {
      "Enabled": true
    }
  },
  "Registration": {
    "Enabled": true,
    "EmailPasswordEnabled": true,
    "TermsVersion": "2026-11"
  },
  "Email": {
    "Mode": "Smtp",
    "WorkerEnabled": true,
    "FromAddress": "scapp.system@gmail.com",
    "FromName": "SCApp",
    "PollIntervalSeconds": 10,
    "BatchSize": 20,
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "TimeoutSeconds": 30
    }
  },
  "App": {
    "WebBaseUrl": "https://localhost:7001"
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "Temperature": 0.2,
    "MaxCvCharacters": 12000,
    "MaxRetries": 2,
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "MinDelayBetweenCallsMs": 4500,
    "TimeoutSeconds": 90,
    "MaxRetryDelaySeconds": 60,
    "PreviewPermitPerMinute": 10,
    "UseFake": false
  },
  "CvUpload": {
    "MaxFileSizeMB": 2,
    "MaxFilesPerRequest": 20,
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg" ],
    "StorageRoot": "Uploads/CV",
    "Endpoint": {
      "Enabled": false,
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "ConcurrentRequests": 4,
      "QueueLimit": 2
    }
  },
  "TextExtraction": {
    "TessdataPath": "tessdata",
    "Languages": "eng+vie",
    "MinCharsPerPage": 50,
    "RenderDpi": 300,
    "MaxOcrPages": 5,
    "MaxImagePixels": 40000000
  },
  "Scoring": {
    "ModelName": "gemini-3.1-flash-lite",
    "Temperature": 0.2,
    "KeywordWeight": 0.3,
    "AiWeight": 0.7,
    "PassThreshold": 70,
    "KeywordMustHaveWeight": 0.6,
    "KeywordNiceToHaveWeight": 0.2,
    "KeywordGpaWeight": 0.1,
    "KeywordExperienceWeight": 0.1,
    "MissingMustHaveCap": 69,
    "WorkerEnabled": false,
    "PollIntervalSeconds": 3
  }
}
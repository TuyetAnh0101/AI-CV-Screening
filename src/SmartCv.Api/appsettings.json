{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "Model": "gemini-3.1-flash-lite",
    "Temperature": 0.2,
    "MaxCvCharacters": 12000,
    "MaxRetries": 2
  },
  "CvUpload": {
    "MaxFileSizeMB": 10,
    "MaxFilesPerRequest": 20,
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg" ],
    "StorageRoot": "Uploads/CV",
    "Endpoint": {
      "Enabled": false,
      "PermitLimit": 30,
      "WindowSeconds": 60,
      "ConcurrentRequests": 4,
      "QueueLimit": 2
    }
  },
  "TextExtraction": {
    "TessdataPath": "tessdata",
    "Languages": "eng+vie",
    "MinCharsPerPage": 50,
    "RenderDpi": 300,
    "MaxOcrPages": 5,
    "MaxImagePixels": 40000000
  }
}